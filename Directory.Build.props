<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Company>DynaIsland</Company>
    <Product>DynaIsland</Product>
    <Version>1.9.0</Version>
    <!-- TFM com SDK do Windows: necessário para Win32 + APIs WinRT (GSMTC, notificações etc.). -->
    <DynaIslandWindowsTfm>net10.0-windows10.0.19041.0</DynaIslandWindowsTfm>
    <DynaIslandMinWindows>10.0.17763.0</DynaIslandMinWindows>
    <!-- Repositório GitHub (dono/nome) cujos Releases públicos indicam novas versões. Vazio desativa a verificação. -->
    <DynaIslandUpdateRepository>danilloteeo/dynasland</DynaIslandUpdateRepository>
  </PropertyGroup>
</Project>
