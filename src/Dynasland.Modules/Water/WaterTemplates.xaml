<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:Dynasland.Modules.Common"
                    xmlns:water="clr-namespace:Dynasland.Modules.Water">

    <common:GlyphContentConverter x:Key="GlyphContent" />

    <DataTemplate x:Key="Dynasland.Modules.Water.WaterReminderContent:Compact">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontSize="13" VerticalAlignment="Center"
                            Foreground="{DynamicResource IslandPrimaryTextBrush}" Focusable="False" IsTabStop="False" />
            <TextBlock Text="Água" Margin="8,0,0,0" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                       Foreground="{DynamicResource IslandPrimaryTextBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Water.WaterReminderContent:Expanded">
        <Grid Margin="20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontSize="22" VerticalAlignment="Center"
                            Foreground="{DynamicResource IslandPrimaryTextBrush}" Focusable="False" IsTabStop="False" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource IslandTextFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Message}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Water.WaterReminderContent:Interactive">
        <Grid Margin="22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontSize="26" VerticalAlignment="Top"
                            Foreground="{DynamicResource IslandPrimaryTextBrush}" Focusable="False" IsTabStop="False" />
                <StackPanel Margin="12,0,0,0" MaxWidth="320">
                    <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource IslandTextFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandPrimaryTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource IslandTextButtonStyle}" Content="{Binding SnoozeLabel}" Command="{Binding SnoozeCommand}" />
                <Button Style="{DynamicResource IslandPrimaryButtonStyle}" Content="{Binding DrinkLabel}" Command="{Binding DrinkCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Confirmação de um copo: a gota enche do progresso anterior ao novo (WaterFillMeter). -->
    <DataTemplate x:Key="Dynasland.Modules.Water.WaterDrankContent:Compact">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <water:WaterFillMeter Width="18" Height="18" VerticalAlignment="Center"
                                  From="{Binding FromProgress}" To="{Binding ToProgress}" Celebrate="{Binding GoalReached}"
                                  Foreground="{DynamicResource IslandPrimaryTextBrush}" />
            <TextBlock Text="{Binding Count}" Margin="8,0,0,0" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                       Foreground="{DynamicResource IslandPrimaryTextBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Water.WaterDrankContent:Expanded">
        <Grid Margin="20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <water:WaterFillMeter Width="40" Height="40" VerticalAlignment="Center"
                                      From="{Binding FromProgress}" To="{Binding ToProgress}" Celebrate="{Binding GoalReached}"
                                      Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource IslandTextFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Message}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Water.WaterDrankContent:Interactive">
        <Grid Margin="22,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <water:WaterFillMeter Width="56" Height="56" VerticalAlignment="Center"
                                      From="{Binding FromProgress}" To="{Binding ToProgress}" Celebrate="{Binding GoalReached}"
                                      Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                <StackPanel Margin="16,0,0,0" MaxWidth="300" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource IslandTextFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandPrimaryTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>
    <!-- Painel do atalho Água: corpo que se enche de água conforme os copos do dia (WaterBodyMeter). -->
    <DataTemplate x:Key="Dynasland.Modules.Water.WaterBodyPanelContent:Compact">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontSize="13" VerticalAlignment="Center"
                            Foreground="{DynamicResource IslandPrimaryTextBrush}" Focusable="False" IsTabStop="False" />
            <TextBlock Text="{Binding Count}" Margin="8,0,0,0" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                       Foreground="{DynamicResource IslandPrimaryTextBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Water.WaterBodyPanelContent:Expanded">
        <Grid Margin="20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <water:WaterBodyMeter Width="26" Height="48" VerticalAlignment="Center"
                                      Progress="{Binding Progress}" Celebrate="{Binding GoalReached}"
                                      Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Message}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Botões do painel de água, como no Volum: pílula azul de 22px e botão de contorno. -->
    <Style x:Key="WaterPillButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontFamily" Value="{DynamicResource IslandTextFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Height="22" CornerRadius="11" Padding="10,0" Background="{DynamicResource IslandWaterBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WaterGhostButton" TargetType="Button" BasedOn="{StaticResource WaterPillButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Height="22" CornerRadius="11" Padding="10,0" Background="Transparent" BorderBrush="#24FFFFFF" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra do dia: degradê do azul escuro ao azul da água, 3px. -->
    <LinearGradientBrush x:Key="WaterBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1A0084FF" Offset="0" />
        <GradientStop Color="#FF0D5598" Offset="0.12" />
        <GradientStop Color="#FF0084FF" Offset="1" />
    </LinearGradientBrush>

    <DataTemplate x:Key="Dynasland.Modules.Water.WaterBodyPanelContent:Interactive">
        <Grid Margin="20,16,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="18"
                                Foreground="{DynamicResource IslandWaterBrush}" VerticalAlignment="Center" Focusable="False" IsTabStop="False" />
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="Água hoje" FontFamily="{DynamicResource IslandTextFont}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                    <TextBlock Text="{Binding LitersText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="10.5"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource WaterGhostButton}" Content="−" Padding="0" Command="{Binding UndoCommand}" ToolTip="{Binding UndoLabel}" />
                    <Button Style="{StaticResource WaterPillButton}" Content="{Binding DrinkMillilitersLabel}" Command="{Binding DrinkCommand}" Margin="6,0,0,0" ToolTip="{Binding DrinkLabel}" />
                </StackPanel>
            </Grid>
            <ProgressBar Grid.Row="1" Style="{DynamicResource IslandProgressBarStyle}" Height="3" Maximum="1" Margin="0,12,0,0"
                         Foreground="{StaticResource WaterBarBrush}" Value="{Binding Progress, Mode=OneWay}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
