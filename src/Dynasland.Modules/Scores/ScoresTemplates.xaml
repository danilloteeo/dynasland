<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:Dynasland.Modules.Common">

    <common:GlyphContentConverter x:Key="GlyphContent" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Painel do placar: título e horário no topo, uma linha por jogo (times, placar, estado) com rolagem. -->
    <DataTemplate x:Key="Dynasland.Modules.Scores.ScoresContent:Interactive">
        <Grid Margin="16,14,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="16"
                                    Foreground="{DynamicResource IslandPrimaryTextBrush}" VerticalAlignment="Center" Focusable="False" IsTabStop="False" />
                    <TextBlock Text="Placar NBA" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource IslandTextFont}" FontSize="12.5"
                               FontWeight="SemiBold" Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{DynamicResource IslandTextFont}" FontSize="10.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource IslandSecondaryTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource IslandWarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <ScrollViewer Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding Games}" Focusable="False" Margin="0,0,6,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Matchup}" VerticalAlignment="Center" FontFamily="{DynamicResource IslandTextFont}" FontSize="12.5"
                                           Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding ScoreText}" VerticalAlignment="Center" FontFamily="{DynamicResource IslandTextFont}" FontSize="12.5"
                                           FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource IslandTextFont}" FontSize="10.5" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource IslandSecondaryTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF6CCB5F" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="1" Text="Nenhum jogo da NBA hoje." Margin="0,14,0,0" HorizontalAlignment="Center" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                       Foreground="{DynamicResource IslandSecondaryTextBrush}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
