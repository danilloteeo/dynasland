<ResourceDictionary
                    xmlns:common="clr-namespace:Dynasland.Modules.Common" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <common:GlyphContentConverter x:Key="GlyphContent" />

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Linha clicável do histórico: copia o item de novo. -->
    <Style x:Key="ClipboardRowButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10" Padding="8,4">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource IslandHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource IslandPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Dynasland.Modules.Clipboard.ClipboardContent:Expanded">
        <Grid Margin="18,0,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="32" Height="32" VerticalAlignment="Center">
                <ContentControl Content="{Binding LatestGlyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="16"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border CornerRadius="6" Visibility="{Binding HasLatestImage, Converter={StaticResource BoolToVisibility}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding LatestImage}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Copiado" FontFamily="{DynamicResource IslandTextFont}" FontSize="11"
                           Foreground="{DynamicResource IslandTertiaryTextBrush}" />
                <TextBlock Text="{Binding LatestPreview}" FontFamily="{DynamicResource IslandTextFont}" FontSize="13"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Clipboard.ClipboardContent:Interactive">
        <Grid Margin="14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="8,0,0,4">
                <TextBlock Text="Área de transferência · clique para copiar de novo" FontFamily="{DynamicResource IslandTextFont}" FontSize="11"
                           Foreground="{DynamicResource IslandTertiaryTextBrush}" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding History}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ClipboardRowButton}" Command="{Binding CopyCommand}" ToolTip="Copiar novamente">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="12"
                                           Foreground="{DynamicResource IslandSecondaryTextBrush}" VerticalAlignment="Center" />
                                <Border Width="18" Height="18" CornerRadius="3" HorizontalAlignment="Left"
                                        Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Preview}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12.5"
                                           Foreground="{DynamicResource IslandPrimaryTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock x:Name="Time" Grid.Column="2" Text="{Binding TimeText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="11"
                                           Foreground="{DynamicResource IslandTertiaryTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding JustCopied}" Value="True">
                                <Setter TargetName="Time" Property="Text" Value="Copiado" />
                                <Setter TargetName="Time" Property="Foreground" Value="{DynamicResource IslandAccentBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Row="1" Text="{Binding HistoryMessage}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                       Foreground="{DynamicResource IslandSecondaryTextBrush}" TextWrapping="Wrap" Margin="8,4" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
