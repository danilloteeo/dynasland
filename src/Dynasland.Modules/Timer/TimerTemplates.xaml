<ResourceDictionary
                    xmlns:common="clr-namespace:Dynasland.Modules.Common" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <common:GlyphContentConverter x:Key="GlyphContent" />

    <SolidColorBrush x:Key="TimerBrush" Color="#FFFF9F0A" />

    <!-- Cronômetro -->
    <DataTemplate x:Key="Dynasland.Modules.Timer.StopwatchContent:Compact">
        <Grid Margin="14,0">
            <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="13"
                       Foreground="{StaticResource TimerBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ElapsedText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TimerBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Timer.StopwatchContent:Expanded">
        <Grid Margin="20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="16"
                           Foreground="{StaticResource TimerBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Cronômetro" FontFamily="{DynamicResource IslandTextFont}" FontSize="13"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding ElapsedText}" FontFamily="{DynamicResource IslandFont}" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource TimerBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Timer.StopwatchContent:Interactive">
        <Grid Margin="24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Cronômetro" FontFamily="{DynamicResource IslandTextFont}" FontSize="12" Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                <TextBlock Text="{Binding ElapsedText}" FontFamily="{DynamicResource IslandFont}" FontSize="42" FontWeight="SemiBold"
                           Foreground="{StaticResource TimerBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding LapGlyph, Converter={StaticResource GlyphContent}}" Command="{Binding LapCommand}"
                        IsEnabled="{Binding IsRunning}" Background="{DynamicResource IslandSurfaceBrush}" Width="44" Height="44" ToolTip="Marcar volta" />
                <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding StopGlyph, Converter={StaticResource GlyphContent}}" Command="{Binding StopCommand}"
                        Background="{DynamicResource IslandSurfaceBrush}" Width="44" Height="44" Margin="10,0,0,0" ToolTip="Parar e zerar" />
                <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding PauseResumeGlyph, Converter={StaticResource GlyphContent}}" Command="{Binding PauseResumeCommand}"
                        Background="{DynamicResource IslandSurfaceBrush}" Width="44" Height="44" Margin="10,0,0,0" ToolTip="Pausar/continuar" />
            </StackPanel>
            <ItemsControl Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Laps}" Focusable="False" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Number, StringFormat=Volta {0}}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                                       Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding LapText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                                       Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                                       Foreground="{DynamicResource IslandTertiaryTextBrush}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>

    <!-- Temporizador -->
    <DataTemplate x:Key="Dynasland.Modules.Timer.CountdownContent:Compact">
        <Grid Margin="14,0">
            <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="13"
                       Foreground="{StaticResource TimerBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding RemainingText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TimerBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Timer.CountdownContent:Expanded">
        <Grid Margin="20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="16"
                           Foreground="{StaticResource TimerBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Temporizador" FontFamily="{DynamicResource IslandTextFont}" FontSize="13"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding RemainingText}" FontFamily="{DynamicResource IslandFont}" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource TimerBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Timer.CountdownContent:Interactive">
        <Grid Margin="24,14,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding DurationText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12" Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                <TextBlock Text="{Binding RemainingText}" FontFamily="{DynamicResource IslandFont}" FontSize="40" FontWeight="SemiBold"
                           Foreground="{StaticResource TimerBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding CancelGlyph, Converter={StaticResource GlyphContent}}" Command="{Binding CancelCommand}"
                        Background="{DynamicResource IslandSurfaceBrush}" Width="42" Height="42" ToolTip="Cancelar" />
                <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding AddGlyph, Converter={StaticResource GlyphContent}}" Command="{Binding AddMinuteCommand}"
                        Background="{DynamicResource IslandSurfaceBrush}" Width="42" Height="42" Margin="8,0,0,0" ToolTip="Mais 1 minuto" />
                <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding PauseResumeGlyph, Converter={StaticResource GlyphContent}}" Command="{Binding PauseResumeCommand}"
                        Background="{DynamicResource IslandSurfaceBrush}" Width="42" Height="42" Margin="8,0,0,0" ToolTip="Pausar/continuar" />
            </StackPanel>
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{DynamicResource IslandProgressBarStyle}" Foreground="{StaticResource TimerBrush}"
                         Maximum="1" Value="{Binding Progress, Mode=OneWay}" Margin="0,8,4,0" />
        </Grid>
    </DataTemplate>

    <!-- Escolha da duração -->
    <DataTemplate x:Key="Dynasland.Modules.Timer.TimerSetupContent:Interactive">
        <StackPanel Margin="20,14" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="4,0,0,10">
                <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="14"
                           Foreground="{StaticResource TimerBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Iniciar temporizador" FontFamily="{DynamicResource IslandTextFont}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}" Margin="8,0,0,0" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Presets}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{DynamicResource IslandTextButtonStyle}" Content="{Binding Label}" Command="{Binding Command}" Margin="4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- Fim do temporizador -->
    <DataTemplate x:Key="Dynasland.Modules.Timer.TimerFinishedContent:Expanded">
        <Grid Margin="20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="18"
                           Foreground="{StaticResource TimerBrush}" VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="Tempo esgotado" FontFamily="{DynamicResource IslandTextFont}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                    <TextBlock Text="{Binding DurationText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Timer.TimerFinishedContent:Interactive">
        <Grid Margin="22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="18"
                           Foreground="{StaticResource TimerBrush}" VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="Tempo esgotado" FontFamily="{DynamicResource IslandTextFont}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                    <TextBlock Text="{Binding DurationText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource IslandTextButtonStyle}" Content="Repetir" Command="{Binding RepeatCommand}" />
                <Button Style="{DynamicResource IslandTextButtonStyle}" Content="OK" Command="{Binding DismissCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>


    <!-- Pomodoro: vermelho no foco, verde nas pausas. -->
    <SolidColorBrush x:Key="FocusBrush" Color="#FFFF6B5B" />
    <SolidColorBrush x:Key="BreakBrush" Color="#FF30D158" />

    <Style x:Key="PomodoroAccentIcon" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{StaticResource FocusBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsBreak}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BreakBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PomodoroAccent" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FocusBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsBreak}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BreakBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Dynasland.Modules.Timer.PomodoroContent:Compact">
        <Grid Margin="14,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="13" Style="{StaticResource PomodoroAccentIcon}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PhaseText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12" Margin="8,0,0,0"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding RemainingText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="13" FontWeight="SemiBold"
                       Style="{StaticResource PomodoroAccent}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Timer.PomodoroContent:Expanded">
        <Grid Margin="20,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding PhaseText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="14" FontWeight="SemiBold" Style="{StaticResource PomodoroAccent}" />
                <TextBlock Text="{Binding CycleText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12" Foreground="{DynamicResource IslandSecondaryTextBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding RemainingText}" FontFamily="{DynamicResource IslandFont}" FontSize="24" FontWeight="SemiBold"
                       Style="{StaticResource PomodoroAccent}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Timer.PomodoroContent:Interactive">
        <Grid Margin="24,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontFamily="{DynamicResource IslandTextFont}" FontSize="12">
                    <Run Text="{Binding PhaseText, Mode=OneWay}" Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                    <Run Text=" · " Foreground="{DynamicResource IslandTertiaryTextBrush}" />
                    <Run Text="{Binding CycleText, Mode=OneWay}" Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                </TextBlock>
                <TextBlock Text="{Binding RemainingText}" FontFamily="{DynamicResource IslandFont}" FontSize="42" FontWeight="SemiBold" Style="{StaticResource PomodoroAccent}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding StopGlyph, Converter={StaticResource GlyphContent}}" Command="{Binding StopCommand}"
                        Background="{DynamicResource IslandSurfaceBrush}" Width="42" Height="42" ToolTip="Encerrar Pomodoro" />
                <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding SkipGlyph, Converter={StaticResource GlyphContent}}" Command="{Binding SkipCommand}"
                        Background="{DynamicResource IslandSurfaceBrush}" Width="42" Height="42" Margin="8,0,0,0" ToolTip="Pular para a próxima fase" />
                <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding PauseResumeGlyph, Converter={StaticResource GlyphContent}}" Command="{Binding PauseResumeCommand}"
                        Background="{DynamicResource IslandSurfaceBrush}" Width="42" Height="42" Margin="8,0,0,0" ToolTip="Pausar/continuar" />
            </StackPanel>
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Maximum="1" Value="{Binding Progress, Mode=OneWay}">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource IslandProgressBarStyle}">
                        <Setter Property="Foreground" Value="{StaticResource FocusBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBreak}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BreakBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding TodayText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="11"
                       Foreground="{DynamicResource IslandTertiaryTextBrush}" Margin="0,6,0,0" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
