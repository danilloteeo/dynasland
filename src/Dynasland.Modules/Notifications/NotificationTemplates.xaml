<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:Dynasland.Modules.Common">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!--
        Ícone do aplicativo. Ícones que preenchem o quadrado aparecem inteiros; desenhos soltos (recortados
        de um bloco transparente) vão menores sobre uma placa; sem ícone, um sino genérico na placa.
    -->
    <DataTemplate x:Key="NotificationLogo">
        <Grid>
            <Border CornerRadius="9" Background="{DynamicResource IslandSurfaceBrush}"
                    Visibility="{Binding ShowPlate, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding FallbackGlyph}" FontFamily="{DynamicResource IslandIconFont}" FontSize="15"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasNoLogo, Converter={StaticResource BoolToVisibility}}" />
            </Border>
            <Image Source="{Binding Logo}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   RenderTransformOrigin="0.5,0.5"
                   Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}">
                <Image.Style>
                    <Style TargetType="Image">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LogoOnPlate}" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.66" ScaleY="0.66" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Grid>
    </DataTemplate>

    <!-- "Aplicativo · hora" na cor do aplicativo; sem cor, no tom terciário. -->
    <Style x:Key="NotificationAppLine" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource IslandTextFont}" />
        <Setter Property="Foreground" Value="{DynamicResource IslandTertiaryTextBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasAccent}" Value="True">
                <Setter Property="Foreground" Value="{Binding AccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Dynasland.Modules.Notifications.NotificationContent:Expanded">
        <Grid>
            <!-- Brilho na cor do aplicativo, centrado no ícone; acompanha os cantos da cápsula. -->
            <Border CornerRadius="31" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush MappingMode="Absolute" Center="38,46" GradientOrigin="38,46" RadiusX="170" RadiusY="170">
                        <GradientStop Offset="0" Color="{Binding GlowColor}" />
                        <GradientStop Offset="1" Color="{Binding GlowEdgeColor}" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="16,0,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl Width="44" Height="44" Content="{Binding}" ContentTemplate="{StaticResource NotificationLogo}" Focusable="False" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Headline}" FontFamily="{DynamicResource IslandTextFont}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource IslandPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding AppLine}" Style="{StaticResource NotificationAppLine}" FontSize="11"
                                   VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="125" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <TextBlock Text="{Binding ExpandedBody}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12" LineHeight="16"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="32" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- Tempo restante antes de a notificação sair da ilha. -->
            <Border Height="2" CornerRadius="1" Margin="34,0,34,7" VerticalAlignment="Bottom" IsHitTestVisible="False"
                    Background="#1AFFFFFF">
                <Border CornerRadius="1" Background="{Binding AccentBrush}" common:CountdownBar.Span="{Binding Countdown}" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Notifications.NotificationContent:Interactive">
        <Grid>
            <Border CornerRadius="35" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush MappingMode="Absolute" Center="30,28" GradientOrigin="30,28" RadiusX="230" RadiusY="150">
                        <GradientStop Offset="0" Color="{Binding GlowColor}" />
                        <GradientStop Offset="1" Color="{Binding GlowEdgeColor}" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="18,16,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Width="24" Height="24" Content="{Binding}" ContentTemplate="{StaticResource NotificationLogo}" Focusable="False" />
                    <TextBlock Grid.Column="1" Text="{Binding AppName}" Style="{StaticResource NotificationAppLine}" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                               Foreground="{DynamicResource IslandTertiaryTextBrush}" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Text="{Binding Headline}" FontFamily="{DynamicResource IslandTextFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Body}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="48" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{DynamicResource IslandTextButtonStyle}" Content="Silenciar app" Command="{Binding MuteAppCommand}"
                            Visibility="{Binding CanMuteApp, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Não mostrar mais notificações deste aplicativo na ilha" />
                    <Button Style="{DynamicResource IslandTextButtonStyle}" Content="Dispensar" Command="{Binding DismissCommand}" Margin="8,0,0,0" />
                    <Button Style="{DynamicResource IslandTextButtonStyle}" Content="Abrir" Command="{Binding OpenCommand}" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
