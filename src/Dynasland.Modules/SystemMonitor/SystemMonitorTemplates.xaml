<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="MetricLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource IslandTextFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource IslandTertiaryTextBrush}" />
    </Style>
    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource IslandFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource IslandPrimaryTextBrush}" />
        <Setter Property="Margin" Value="0,1,0,4" />
    </Style>
    <Style x:Key="MetricDetail" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource IslandTextFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource IslandSecondaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,5,0,0" />
    </Style>

    <DataTemplate x:Key="Dynasland.Modules.SystemMonitor.SystemMonitorContent:Interactive">
        <DockPanel Margin="20,16,20,12">
            <!-- Rede: download e upload somados de todas as conexões. -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Rede" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" Width="40" />
                <TextBlock Text="↓" FontSize="12" Foreground="{DynamicResource IslandAccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding NetworkDownText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}" VerticalAlignment="Center" Margin="5,0,0,0" MinWidth="86" />
                <TextBlock Text="↑" FontSize="12" Foreground="{DynamicResource IslandSecondaryTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding NetworkUpText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12.5"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}" VerticalAlignment="Center" Margin="5,0,0,0" />
            </StackPanel>
        <UniformGrid Columns="4">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="CPU" Style="{StaticResource MetricLabel}" />
                <TextBlock Text="{Binding CpuText}" Style="{StaticResource MetricValue}" />
                <ProgressBar Style="{DynamicResource IslandProgressBarStyle}" Maximum="100" Value="{Binding CpuValue, Mode=OneWay}" />
                <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource MetricDetail}" ToolTip="{Binding CpuDetail}" />
            </StackPanel>
            <StackPanel Margin="6,0">
                <TextBlock Text="Memória" Style="{StaticResource MetricLabel}" />
                <TextBlock Text="{Binding MemoryText}" Style="{StaticResource MetricValue}" />
                <ProgressBar Style="{DynamicResource IslandProgressBarStyle}" Maximum="100" Value="{Binding MemoryValue, Mode=OneWay}" />
                <TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource MetricDetail}" />
            </StackPanel>
            <StackPanel Margin="6,0">
                <TextBlock Text="GPU" Style="{StaticResource MetricLabel}" />
                <TextBlock Text="{Binding GpuText}" Style="{StaticResource MetricValue}" />
                <ProgressBar Style="{DynamicResource IslandProgressBarStyle}" Maximum="100" Value="{Binding GpuValue, Mode=OneWay}" />
                <TextBlock Text="{Binding GpuDetail}" Style="{StaticResource MetricDetail}" ToolTip="{Binding GpuDetail}" />
            </StackPanel>
            <StackPanel Margin="12,0,0,0">
                <TextBlock Text="Disco" Style="{StaticResource MetricLabel}" />
                <TextBlock Text="{Binding DiskText}" Style="{StaticResource MetricValue}" />
                <ProgressBar Style="{DynamicResource IslandProgressBarStyle}" Maximum="100" Value="{Binding DiskValue, Mode=OneWay}" />
                <TextBlock Text="{Binding DiskDetail}" Style="{StaticResource MetricDetail}" />
            </StackPanel>
        </UniformGrid>
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.SystemMonitor.SystemAlertContent:Expanded">
        <Grid Margin="20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="Icon" Text="{Binding Glyph}" FontFamily="{DynamicResource IslandIconFont}" FontSize="18"
                           Foreground="{DynamicResource IslandWarningBrush}" VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource IslandTextFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                    <TextBlock Text="{Binding Detail}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSevere}" Value="True">
                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource IslandCriticalBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
