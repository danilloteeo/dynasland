<ResourceDictionary
                    xmlns:common="clr-namespace:Dynasland.Modules.Common" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <common:GlyphContentConverter x:Key="GlyphContent" />

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Capa arredondada; sem capa, mostra uma nota musical. -->
    <DataTemplate x:Key="MediaArtwork">
        <Grid>
            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF7C4DFF" Offset="0" />
                        <GradientStop Color="#FF3A2A9C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <ContentControl Content="{Binding MusicGlyph, Converter={StaticResource GlyphContent}}"
                           FontFamily="{DynamicResource IslandIconFont}"
                           FontSize="16"
                           Foreground="#FFFFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                    Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Equalizador: 4 barras animadas a 20 fps apenas enquanto IsIndicatorAnimating. -->
    <DataTemplate x:Key="MediaEqualizer">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="14">
            <StackPanel.Resources>
                <Style TargetType="Rectangle">
                    <Setter Property="Width" Value="3" />
                    <Setter Property="Margin" Value="1,0" />
                    <Setter Property="RadiusX" Value="1.5" />
                    <Setter Property="RadiusY" Value="1.5" />
                    <Setter Property="Fill" Value="{DynamicResource IslandAccentBrush}" />
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                </Style>
            </StackPanel.Resources>
            <Rectangle x:Name="Bar1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.35" /></Rectangle.RenderTransform></Rectangle>
            <Rectangle x:Name="Bar2"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.6" /></Rectangle.RenderTransform></Rectangle>
            <Rectangle x:Name="Bar3"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.45" /></Rectangle.RenderTransform></Rectangle>
            <Rectangle x:Name="Bar4"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform></Rectangle>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsIndicatorAnimating}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Equalize">
                        <Storyboard Timeline.DesiredFrameRate="20" RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="Bar1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.42" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="Bar2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.25" Duration="0:0:0.55" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="Bar3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.36" AutoReverse="True" RepeatBehavior="Forever" />
                            <DoubleAnimation Storyboard.TargetName="Bar4" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.8" Duration="0:0:0.48" AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Equalize" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                <Setter TargetName="Bar1" Property="Opacity" Value="0.45" />
                <Setter TargetName="Bar2" Property="Opacity" Value="0.45" />
                <Setter TargetName="Bar3" Property="Opacity" Value="0.45" />
                <Setter TargetName="Bar4" Property="Opacity" Value="0.45" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Media.MediaContent:Compact">
        <Grid Margin="7,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl Width="22" Height="22" Tag="6" Content="{Binding}" ContentTemplate="{StaticResource MediaArtwork}" Focusable="False" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource MediaEqualizer}" Focusable="False" />
                <!-- Outras mídias tocando ou pausadas (alterne pelas abas no estado interativo). -->
                <TextBlock Text="{Binding OtherSessionsText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}" VerticalAlignment="Center" Margin="6,0,0,0"
                           Visibility="{Binding HasOtherSessions, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Media.MediaContent:Expanded">
        <Grid Margin="13,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl Width="48" Height="48" Tag="12" Content="{Binding}" ContentTemplate="{StaticResource MediaArtwork}" Focusable="False" />
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource IslandTextFont}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
            </StackPanel>
            <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource MediaEqualizer}" Focusable="False">
                <ContentControl.LayoutTransform>
                    <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                </ContentControl.LayoutTransform>
            </ContentControl>
        </Grid>
    </DataTemplate>

    <!-- Linha da fila do Spotify: clicar pula até a faixa. -->
    <DataTemplate x:Key="QueueRow">
        <Button Command="{Binding Select}" Focusable="False" Cursor="Hand" ToolTip="Pular até esta faixa" Margin="0,1">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="4,3">
                        <Grid Height="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="4" Background="{DynamicResource IslandSurfaceBrush}" ClipToBounds="True">
                                <Image Source="{Binding Image}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                                           Foreground="{DynamicResource IslandPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artists}" FontFamily="{DynamicResource IslandTextFont}" FontSize="10.5"
                                           Foreground="{DynamicResource IslandSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource IslandHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Media.MediaContent:Interactive">
        <Grid Margin="16,14,16,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl Width="48" Height="48" Tag="9" Content="{Binding}" ContentTemplate="{StaticResource MediaArtwork}" Focusable="False" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontFamily="{DynamicResource IslandTextFont}" FontSize="10.5"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                </StackPanel>
            </Grid>

            <!-- Barra de 3px com os tempos embaixo, como no Volum. -->
            <StackPanel Grid.Row="1" Margin="0,10,0,0" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVisibility}}">
                <!-- Só mostra a posição (barra com bolinha, como no modelo); não responde ao clique. -->
                <Slider Style="{DynamicResource IslandSliderStyle}" Height="12" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                        IsHitTestVisible="False" Focusable="False" Margin="0,2,0,2" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" FontSize="9.5" Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                    <TextBlock Text="{Binding PositionText}" FontSize="9.5" Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                </DockPanel>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding PreviousGlyph, Converter={StaticResource GlyphContent}}" Command="{Binding PreviousCommand}"
                        IsEnabled="{Binding CanSkipPrevious}" Width="26" Height="26" FontSize="13" ToolTip="Anterior" />
                <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding PlayPauseGlyph, Converter={StaticResource GlyphContent}}" Command="{Binding PlayPauseCommand}"
                        IsEnabled="{Binding CanPlayPause}" Width="26" Height="26" FontSize="13" Margin="12,0" ToolTip="Reproduzir/pausar" />
                <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding NextGlyph, Converter={StaticResource GlyphContent}}" Command="{Binding NextCommand}"
                        IsEnabled="{Binding CanSkipNext}" Width="26" Height="26" FontSize="13" ToolTip="Próxima" />
            </StackPanel>

            <!-- Volume do sistema, sem sair do painel de mídia. -->
            <Grid Grid.Row="4" Margin="0,6,0,0" Visibility="{Binding HasAppVolume, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding VolumeGlyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}" Margin="4,0,0,0" />
                <Slider Grid.Column="1" Style="{DynamicResource IslandSliderStyle}" Margin="10,0,4,0" VerticalAlignment="Center"
                        Maximum="100" Value="{Binding AppVolume, Mode=TwoWay, Delay=60}"
                        AutomationProperties.Name="{Binding VolumeLabel}" ToolTip="{Binding VolumeLabel}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding VolumeMessage}" FontFamily="{DynamicResource IslandTextFont}" FontSize="10.5"
                           Foreground="{DynamicResource IslandWarningBrush}" Margin="4,2,0,0" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasVolumeMessage, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Letra sincronizada: verso anterior, atual em destaque e o próximo. -->
            <StackPanel Grid.Row="3" Height="62" Margin="0,8,0,0" Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding LyricPrevious}" FontFamily="{DynamicResource IslandTextFont}" FontSize="11.5" Height="17"
                           Foreground="{DynamicResource IslandTertiaryTextBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding LyricCurrent}" FontFamily="{DynamicResource IslandTextFont}" FontSize="14.5" FontWeight="SemiBold" Height="24"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding LyricCurrent}" />
                <TextBlock Text="{Binding LyricNext}" FontFamily="{DynamicResource IslandTextFont}" FontSize="11.5" Height="17"
                           Foreground="{DynamicResource IslandTertiaryTextBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- A seguir (fila do Spotify, com a conta conectada nas configurações). -->
            <StackPanel Grid.Row="5" Margin="0,8,0,0" Visibility="{Binding HasQueue, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="2,0,0,2">
                    <Button DockPanel.Dock="Right" Style="{DynamicResource IslandTextButtonStyle}" Content="{Binding FullQueueText}"
                            Command="{Binding ShowFullQueueCommand}" Padding="8,1" FontSize="10.5" />
                    <TextBlock Text="A seguir" FontFamily="{DynamicResource IslandTextFont}" FontSize="11" Foreground="{DynamicResource IslandTertiaryTextBrush}"
                               VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Queue}" Focusable="False" ItemTemplate="{StaticResource QueueRow}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Fila completa: rolagem com a roda do mouse; clicar pula até a faixa. -->
    <DataTemplate x:Key="Dynasland.Modules.Media.QueueContent:Interactive">
        <DockPanel Margin="14,12,8,10">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontFamily="{DynamicResource IslandTextFont}" FontSize="11.5"
                       Foreground="{DynamicResource IslandSecondaryTextBrush}" Margin="6,0,0,6" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False" ItemTemplate="{StaticResource QueueRow}" Margin="0,0,6,0" />
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>
