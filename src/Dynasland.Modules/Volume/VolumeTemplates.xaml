<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="Dynasland.Modules.Volume.VolumeContent:Expanded">
        <Grid Margin="18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IslandIconFont}" FontSize="16"
                       Foreground="{DynamicResource IslandPrimaryTextBrush}" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1" Style="{DynamicResource IslandProgressBarStyle}" Height="6" Maximum="100"
                         Value="{Binding Level, Mode=OneWay}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Percent}" FontFamily="{DynamicResource IslandTextFont}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource IslandPrimaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <BooleanToVisibilityConverter x:Key="VolumeBoolToVisibility" />

    <DataTemplate x:Key="Dynasland.Modules.Volume.VolumeContent:Interactive">
        <Grid Margin="16,14,22,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Volume por aplicativo (misturador do Windows): só quem está fazendo som. -->
            <StackPanel Grid.Row="4" Margin="0,10,0,0" Visibility="{Binding HasApps, Converter={StaticResource VolumeBoolToVisibility}}">
                <TextBlock Text="Aplicativos" FontFamily="{DynamicResource IslandTextFont}" FontSize="11"
                           Foreground="{DynamicResource IslandTertiaryTextBrush}" Margin="6,0,0,2" />
                <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{DynamicResource IslandIconButtonStyle}" Width="28" Height="28" FontSize="13" Content="{Binding Glyph}"
                                        Command="{Binding ToggleMuteCommand}" ToolTip="Silenciar este aplicativo" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12" Margin="6,0,0,0"
                                           Foreground="{DynamicResource IslandPrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}" />
                                <Slider Grid.Column="2" Style="{DynamicResource IslandSliderStyle}" Margin="8,0,0,0" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding Name}" Value="{Binding Level, Mode=TwoWay, Delay=40}" />
                                <TextBlock Grid.Column="3" Text="{Binding Percent, StringFormat={}{0}%}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                                           Foreground="{DynamicResource IslandSecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid Margin="6,0,0,0">
                <TextBlock Text="{Binding DeviceName}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,48,0" />
                <TextBlock Text="{Binding Percent, StringFormat={}{0}%}" FontFamily="{DynamicResource IslandTextFont}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}" HorizontalAlignment="Right" />
            </Grid>
            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding Glyph}" Command="{Binding ToggleMuteCommand}" ToolTip="Mudo" />
                <Slider Grid.Column="1" Style="{DynamicResource IslandSliderStyle}" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Volume"
                        Value="{Binding Level, Mode=TwoWay}" />
            </Grid>

            <!-- Microfone padrão -->
            <Grid Grid.Row="2" Margin="0,8,0,0" Visibility="{Binding HasMicrophone, Converter={StaticResource VolumeBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding MicrophoneGlyph}" Command="{Binding ToggleMicrophoneMuteCommand}"
                        ToolTip="Ligar/desligar o microfone" />
                <Slider Grid.Column="1" Style="{DynamicResource IslandSliderStyle}" Margin="8,0,0,0" VerticalAlignment="Center"
                        AutomationProperties.Name="Volume do microfone" Value="{Binding MicrophoneLevel, Mode=TwoWay}" ToolTip="{Binding MicrophoneName}" />
                <TextBlock Grid.Column="2" Text="{Binding MicrophonePercent, StringFormat={}{0}%}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <!-- Saídas: clicar torna padrão -->
            <ScrollViewer Grid.Row="3" Margin="4,10,0,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasDeviceChoice, Converter={StaticResource VolumeBoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Outputs}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="Chip" Style="{DynamicResource IslandTextButtonStyle}" Command="{Binding Select}" Margin="0,0,6,0"
                                    Padding="10,3" FontSize="11.5" MaxWidth="170" ToolTip="{Binding Name}">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                    <Setter TargetName="Chip" Property="Foreground" Value="{DynamicResource IslandAccentBrush}" />
                                    <Setter TargetName="Chip" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
