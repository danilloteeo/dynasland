<ResourceDictionary
                    xmlns:common="clr-namespace:Dynasland.Modules.Common" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <common:GlyphContentConverter x:Key="GlyphContent" />

    <BooleanToVisibilityConverter x:Key="CaptureBoolToVisibility" />
    <SolidColorBrush x:Key="RecordingBrush" Color="#FFFF453A" />

    <!-- Botão grande do painel: ícone + rótulo. -->
    <Style x:Key="CaptureActionButton" TargetType="Button" BasedOn="{StaticResource IslandTextButtonStyle}">
        <Setter Property="Width" Value="84" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <DataTemplate x:Key="Dynasland.Modules.Capture.CapturePanelContent:Interactive">
        <StackPanel Margin="16,12" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource CaptureActionButton}" Command="{Binding RegionCommand}" ToolTip="Capturar região (Ctrl+Alt+S)">
                    <StackPanel>
                        <ContentControl Content="{Binding RegionGlyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Região" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CaptureActionButton}" Command="{Binding ScreenCommand}" ToolTip="Capturar a tela inteira (Ctrl+Alt+Shift+S)">
                    <StackPanel>
                        <ContentControl Content="{Binding ScreenGlyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Tela" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CaptureActionButton}" Command="{Binding WindowCommand}" ToolTip="Capturar a janela ativa (Ctrl+Alt+W)">
                    <StackPanel>
                        <ContentControl Content="{Binding WindowGlyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Janela" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CaptureActionButton}" Command="{Binding RecordCommand}" ToolTip="Gravar a tela (Ctrl+Alt+R)">
                    <StackPanel>
                        <ContentControl Content="{Binding RecordGlyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="18" HorizontalAlignment="Center"
                                   Foreground="{StaticResource RecordingBrush}" />
                        <TextBlock Text="{Binding RecordLabel}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <DockPanel Margin="4,10,4,0">
                <Button DockPanel.Dock="Right" Style="{DynamicResource IslandTextButtonStyle}" Content="Ver capturas" Command="{Binding OpenHistoryCommand}"
                        Padding="10,2" FontSize="11" />
                <TextBlock Text="{Binding Message}" FontFamily="{DynamicResource IslandTextFont}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource IslandWarningBrush}" TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Resultado -->
    <DataTemplate x:Key="Dynasland.Modules.Capture.CaptureResultContent:Expanded">
        <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="60" Height="44" CornerRadius="5" Visibility="{Binding HasThumbnail, Converter={StaticResource CaptureBoolToVisibility}}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="20" VerticalAlignment="Center"
                       Foreground="{StaticResource RecordingBrush}" Margin="8,0">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource IslandTextFont}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                <TextBlock Text="{Binding Detail}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12" Foreground="{DynamicResource IslandSecondaryTextBrush}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Capture.CaptureResultContent:Interactive">
        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Dynasland.Modules.Capture.CaptureResultContent:Expanded}" Margin="-16,0,0,0" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Style="{DynamicResource IslandTextButtonStyle}" Content="{Binding CopyLabel}" Command="{Binding CopyCommand}" Margin="0,0,6,0"
                        Visibility="{Binding CanCopy, Converter={StaticResource CaptureBoolToVisibility}}" />
                <Button Style="{DynamicResource IslandTextButtonStyle}" Content="Abrir" Command="{Binding OpenCommand}" Margin="0,0,6,0" />
                <Button Style="{DynamicResource IslandTextButtonStyle}" Content="Mostrar na pasta" Command="{Binding RevealCommand}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Gravação em andamento -->
    <DataTemplate x:Key="Dynasland.Modules.Capture.RecordingContent:Compact">
        <Grid Margin="14,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{StaticResource RecordingBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StateText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12" Margin="8,0,0,0"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding ElapsedText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource RecordingBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                <Setter TargetName="Dot" Property="Opacity" Value="0.4" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Capture.RecordingContent:Expanded">
        <Grid Margin="20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="11" Height="11" Fill="{StaticResource RecordingBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StateText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding ElapsedText}" FontFamily="{DynamicResource IslandFont}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource RecordingBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Capture.RecordingContent:Interactive">
        <Grid Margin="24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontFamily="{DynamicResource IslandTextFont}" FontSize="12">
                    <Run Text="{Binding StateText, Mode=OneWay}" Foreground="{StaticResource RecordingBrush}" />
                    <Run Text="{Binding TargetText, Mode=OneWay, StringFormat= · {0}}" Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                </TextBlock>
                <TextBlock Text="{Binding ElapsedText}" FontFamily="{DynamicResource IslandFont}" FontSize="38" FontWeight="SemiBold"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding PauseResumeGlyph, Converter={StaticResource GlyphContent}}" Command="{Binding PauseResumeCommand}"
                        Background="{DynamicResource IslandSurfaceBrush}" Width="44" Height="44" ToolTip="Pausar/continuar" />
                <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding StopGlyph, Converter={StaticResource GlyphContent}}" Command="{Binding StopCommand}"
                        Background="{StaticResource RecordingBrush}" Width="44" Height="44" Margin="10,0,0,0" ToolTip="Parar e salvar" />
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
