<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Chave: "{NomeCompletoDoTipo}:{Estado}". Os pincéis/fontes vêm do tema da aplicação. -->
    <DataTemplate x:Key="Dynasland.Modules.Clock.ClockContent:Interactive">
        <Grid Margin="16,10,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding TimeText}"
                           FontFamily="{DynamicResource IslandFont}"
                           FontSize="44"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DateText}"
                           FontFamily="{DynamicResource IslandTextFont}"
                           FontSize="14"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}"
                           HorizontalAlignment="Center" />

                <!-- Informações rápidas dos módulos (clima, próximo compromisso). -->
                <ItemsControl ItemsSource="{Binding Glances}" Focusable="False" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding Command}" Focusable="False" Cursor="Hand" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                                    ToolTip="{Binding Text}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Orientation="Horizontal" Background="Transparent" Margin="0,1">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IslandIconFont}" FontSize="12"
                                                       Foreground="{DynamicResource IslandAccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12.5" Margin="7,0,0,0" MaxWidth="330"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource IslandPrimaryTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Atalhos registrados pelos módulos ativos (e Configurações). -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Shortcuts}" Focusable="False" HorizontalAlignment="Center" Margin="0,8,0,0"
                          Visibility="{Binding HasShortcuts, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 7 atalhos por linha (ClockContent.ShortcutsPerRow): 7 × 44 px. -->
                        <WrapPanel Orientation="Horizontal" MaxWidth="308" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding Glyph}" Command="{Binding Command}"
                                ToolTip="{Binding Label}" Background="{DynamicResource IslandSurfaceBrush}" Margin="4,3" FontSize="15" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
