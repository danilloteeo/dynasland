<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Chave: "{NomeCompletoDoTipo}:{Estado}". Os pincéis/fontes vêm do tema da aplicação. -->
    <DataTemplate x:Key="Dynasland.Modules.Clock.ClockContent:Interactive">
        <Grid Margin="16,10,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding TimeText}"
                           FontFamily="{DynamicResource IslandFont}"
                           FontSize="44"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DateText}"
                           FontFamily="{DynamicResource IslandTextFont}"
                           FontSize="14"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Atalhos registrados pelos módulos ativos (e Configurações). -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Shortcuts}" Focusable="False" HorizontalAlignment="Center" Margin="0,8,0,0"
                          Visibility="{Binding HasShortcuts, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding Glyph}" Command="{Binding Command}"
                                ToolTip="{Binding Label}" Background="{DynamicResource IslandSurfaceBrush}" Margin="5,0" FontSize="15" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
