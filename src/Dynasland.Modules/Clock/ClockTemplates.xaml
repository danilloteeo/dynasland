<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:Dynasland.Modules.Common">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <common:GlyphContentConverter x:Key="GlyphContent" />

    <!-- Chave: "{NomeCompletoDoTipo}:{Estado}". Os pincéis/fontes vêm do tema da aplicação. -->

    <!-- Ilha em repouso (nenhum outro módulo com algo a mostrar): data e hora. -->
    <DataTemplate x:Key="Dynasland.Modules.Clock.ClockContent:Compact">
        <Grid x:Name="Idle" Margin="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Data, clima ou próximo compromisso (Aparência › Ilha em repouso). -->
            <DockPanel x:Name="Info" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Left" Text="{Binding IdleGlyph}" FontFamily="{DynamicResource IslandIconFont}" FontSize="12" Margin="0,0,6,0"
                           Foreground="{DynamicResource IslandAccentBrush}" VerticalAlignment="Center"
                           Visibility="{Binding HasIdleGlyph, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding IdleText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock x:Name="Time" Grid.Column="1" Text="{Binding TimeText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource IslandPrimaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsIdleTimeOnly}" Value="True">
                <Setter TargetName="Info" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Time" Property="Grid.Column" Value="0" />
                <Setter TargetName="Time" Property="Grid.ColumnSpan" Value="2" />
                <Setter TargetName="Time" Property="HorizontalAlignment" Value="Center" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsIdleVisible}" Value="False">
                <Setter TargetName="Idle" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="Dynasland.Modules.Clock.ClockContent:Interactive">
        <Grid Margin="16,10,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding TimeText}"
                           FontFamily="{DynamicResource IslandFont}"
                           FontSize="44"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DateText}"
                           FontFamily="{DynamicResource IslandTextFont}"
                           FontSize="14"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}"
                           HorizontalAlignment="Center" />

                <!-- Informações rápidas dos módulos (clima, próximo compromisso). -->
                <ItemsControl ItemsSource="{Binding Glances}" Focusable="False" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding Command}" Focusable="False" Cursor="Hand" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                                    ToolTip="{Binding Text}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <StackPanel Orientation="Horizontal" Background="Transparent" Margin="0,1">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IslandIconFont}" FontSize="12"
                                                       Foreground="{DynamicResource IslandAccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12.5" Margin="7,0,0,0" MaxWidth="330"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource IslandPrimaryTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Atalhos registrados pelos módulos ativos (e Configurações). -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Shortcuts}" Focusable="False" HorizontalAlignment="Center" Margin="0,8,0,0"
                          Visibility="{Binding HasShortcuts, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 7 atalhos por linha (ClockContent.ShortcutsPerRow): 7 × 44 px. -->
                        <WrapPanel Orientation="Horizontal" MaxWidth="308" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{DynamicResource IslandIconButtonStyle}" Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" Command="{Binding Command}"
                                ToolTip="{Binding Label}" Background="{DynamicResource IslandSurfaceBrush}" Margin="4,3" FontSize="15" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
