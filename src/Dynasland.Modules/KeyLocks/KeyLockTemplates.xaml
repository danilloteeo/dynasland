<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:Dynasland.Modules.Common">

    <common:GlyphContentConverter x:Key="GlyphContent" />

    <!-- Aviso de tecla: ícone do teclado, nome da tecla e se ficou ligada ou desligada. -->
    <DataTemplate x:Key="Dynasland.Modules.KeyLocks.KeyLockContent:Expanded">
        <Grid Margin="18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="18"
                            Foreground="{DynamicResource IslandPrimaryTextBrush}" VerticalAlignment="Center" Focusable="False" IsTabStop="False" />
            <TextBlock Grid.Column="1" Text="{Binding Key}" Margin="12,0" VerticalAlignment="Center" FontFamily="{DynamicResource IslandTextFont}" FontSize="12.5"
                       FontWeight="SemiBold" Foreground="{DynamicResource IslandPrimaryTextBrush}" />
            <TextBlock Grid.Column="2" Text="{Binding StateText}" VerticalAlignment="Center" FontFamily="{DynamicResource IslandTextFont}" FontSize="11"
                       Foreground="{DynamicResource IslandSecondaryTextBrush}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
