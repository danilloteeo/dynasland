<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="Dynasland.Modules.Brightness.BrightnessContent:Expanded">
        <Grid Margin="18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IslandIconFont}" FontSize="16"
                       Foreground="{DynamicResource IslandPrimaryTextBrush}" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1" Style="{DynamicResource IslandProgressBarStyle}" Height="6" Maximum="100"
                         Value="{Binding Level, Mode=OneWay}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Percent}" FontFamily="{DynamicResource IslandTextFont}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource IslandPrimaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Modules.Brightness.BrightnessContent:Interactive">
        <Grid Margin="22,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="Brilho" FontFamily="{DynamicResource IslandTextFont}" FontSize="12" Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                <TextBlock Text="{Binding Percent, StringFormat={}{0}%}" FontFamily="{DynamicResource IslandTextFont}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}" HorizontalAlignment="Right" />
            </Grid>
            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IslandIconFont}" FontSize="16"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Style="{DynamicResource IslandSliderStyle}" Margin="14,0,0,0" VerticalAlignment="Center"
                        Value="{Binding Level, Mode=TwoWay}" />
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
