<UserControl x:Class="Dynasland.App.Views.Hub.FocusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hub="clr-namespace:Dynasland.App.ViewModels.Hub"
             xmlns:converters="clr-namespace:Dynasland.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=hub:FocusPageViewModel}"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:FractionToLengthConverter x:Key="BarHeight" Maximum="86" />

        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Foco" Style="{StaticResource SettingsTitle}" />
            <TextBlock Text="Focos do Pomodoro, temporizadores e cronômetros registrados pelo Focus Center." Style="{StaticResource SettingsSubtitle}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Resumo -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,18,0,0">
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding TodayCount}" Style="{StaticResource StatNumber}" />
                    <TextBlock Text="focos hoje" Style="{StaticResource CardDescription}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding TodayFocus}" Style="{StaticResource StatNumber}" />
                    <TextBlock Text="de foco hoje" Style="{StaticResource CardDescription}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding WeekCount}" Style="{StaticResource StatNumber}" />
                    <TextBlock Text="focos em 7 dias" Style="{StaticResource CardDescription}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="{Binding WeekFocus}" Style="{StaticResource StatNumber}" />
                    <TextBlock Text="de foco em 7 dias" Style="{StaticResource CardDescription}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Minutos de foco por dia -->
        <Border Grid.Row="2" Style="{StaticResource SettingsCard}" Margin="0,8,0,0" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Foco por dia" Style="{StaticResource SettingsGroupHeader}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Days}" Height="110" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type hub:FocusDayBar}">
                            <Grid ToolTip="{Binding Tooltip}" Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Width="26" VerticalAlignment="Bottom" CornerRadius="4,4,0,0" Background="{DynamicResource SettingsAccentBrush}"
                                        Height="{Binding Height, Converter={StaticResource BarHeight}}" MinHeight="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="0.55" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,4,0,0" Style="{StaticResource CardDescription}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Sessões recentes -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <ListBox ItemsSource="{Binding Sessions}" Background="Transparent" BorderThickness="0" Focusable="False"
                     ItemContainerStyle="{StaticResource HubListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Sessões recentes">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBar}" />
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type hub:FocusSessionItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13" />
                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource CardDescription}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="13" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Nenhuma sessão nos últimos 7 dias. Comece um Pomodoro pela ilha ou com Ctrl+Alt+P."
                       Style="{StaticResource CardDescription}" Margin="4,6,0,0"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <Button Grid.Row="4" HorizontalAlignment="Right" Margin="0,10,0,0" Style="{StaticResource SettingsButton}"
                Content="Limpar histórico" Command="{Binding ClearCommand}" />
    </Grid>
</UserControl>
