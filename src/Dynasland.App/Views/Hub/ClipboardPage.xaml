<UserControl x:Class="Dynasland.App.Views.Hub.ClipboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hub="clr-namespace:Dynasland.App.ViewModels.Hub"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=hub:ClipboardPageViewModel}"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HistoryEnabled}"
                      VerticalAlignment="Center" AutomationProperties.Name="Guardar histórico" ToolTip="Guardar o que for copiado" />
            <TextBlock DockPanel.Dock="Right" Text="Guardar histórico" Style="{StaticResource CardDescription}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel>
                <TextBlock Text="Área de transferência" Style="{StaticResource SettingsTitle}" />
                <TextBlock Text="Texto e imagens copiados. Conteúdo privado e textos com aparência de senha, cartão ou chave não são guardados."
                           Style="{StaticResource SettingsSubtitle}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,18,0,12">
            <RadioButton DockPanel.Dock="Right" Style="{StaticResource OptionRow}" Content="Favoritos" Margin="8,0,0,0" Padding="12,6"
                         IsChecked="{Binding FavoritesOnly}" GroupName="ClipboardFilter" />
            <RadioButton DockPanel.Dock="Right" Style="{StaticResource OptionRow}" Content="Todos" Margin="8,0,0,0" Padding="12,6"
                         IsChecked="True" GroupName="ClipboardFilter" />
            <TextBox x:Name="Search" Style="{StaticResource SettingsTextBox}" Tag="Buscar no histórico…"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar no histórico" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource HubListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                     MouseDoubleClick="OnItemDoubleClick" AutomationProperties.Name="Itens copiados">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBar}" />
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type hub:ClipboardItemViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="4" Margin="0,0,10,0" Background="{DynamicResource SettingsChipBrush}"
                                    Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" FontSize="13" MaxHeight="36" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DetailText}" Style="{StaticResource CardDescription}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Button Style="{StaticResource HubIconButton}" Content="&#xE8C8;" ToolTip="Copiar"
                                        Command="{Binding DataContext.CopyCommand, ElementName=List}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource HubIconButton}" Content="{Binding FavoriteGlyph}" ToolTip="{Binding FavoriteToolTip}"
                                        Command="{Binding DataContext.ToggleFavoriteCommand, ElementName=List}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource HubIconButton}" Content="&#xE74D;" ToolTip="Excluir"
                                        Command="{Binding DataContext.DeleteCommand, ElementName=List}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Margin="4,10,20,0"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <!-- Pré-visualização do item selecionado -->
            <Border Grid.Column="1" Style="{StaticResource SettingsCard}" Margin="14,0,0,4" Padding="14"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Pré-visualização" Style="{StaticResource SettingsGroupHeader}" Margin="0,0,0,8" />
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource AccentButton}" Content="Copiar" Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" Command="{Binding CopyCommand}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding CopiedMessage}" Style="{StaticResource CardDescription}" Margin="0,8,0,0" />
                    <Grid>
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" VerticalAlignment="Top"
                               Visibility="{Binding SelectedIsImage, Converter={StaticResource BoolToVisibility}}" />
                        <TextBox Text="{Binding Selected.FullText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource SettingsTextBrush}" FontSize="12.5"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Texto completo">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIsImage}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource SettingsButton}" Content="Limpar histórico" Command="{Binding ClearCommand}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CardDescription}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
