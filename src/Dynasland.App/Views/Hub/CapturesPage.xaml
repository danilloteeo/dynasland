<UserControl
             xmlns:controls="clr-namespace:Dynasland.App.Controls" x:Class="Dynasland.App.Views.Hub.CapturesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hub="clr-namespace:Dynasland.App.ViewModels.Hub"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=hub:CapturesPageViewModel}"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Capturas" Style="{StaticResource SettingsTitle}" />
            <TextBlock Text="Capturas de tela (Ctrl+Alt+S região · Ctrl+Alt+Shift+S tela · Ctrl+Alt+W janela) e gravações (Ctrl+Alt+R)."
                       Style="{StaticResource SettingsSubtitle}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ListBox x:Name="List" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource HubListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnItemDoubleClick" AutomationProperties.Name="Capturas recentes">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBar}" />
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type hub:CaptureItemViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="80" Height="50" CornerRadius="4" Background="{DynamicResource SettingsChipBrush}" Margin="0,0,12,0">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    <ContentControl Content="{Binding Source=vector:record, Converter={StaticResource GlyphContent}}" FontFamily="{StaticResource IslandIconFont}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SettingsSecondaryTextBrush}"
                                               Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDescription}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource HubIconButton}" Content="vector:openfile" ToolTip="Abrir"
                                        Command="{Binding DataContext.OpenCommand, ElementName=List}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource HubIconButton}" Content="vector:folderopen" ToolTip="Mostrar na pasta"
                                        Command="{Binding DataContext.RevealCommand, ElementName=List}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource HubIconButton}" Content="vector:trash" ToolTip="Excluir"
                                        Command="{Binding DataContext.DeleteCommand, ElementName=List}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <controls:EmptyState Text="Nenhuma captura ainda." Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Top" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource SettingsButton}" Content="Pasta de imagens" Command="{Binding OpenPicturesCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource SettingsButton}" Content="Pasta de vídeos" Command="{Binding OpenVideosCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
