<UserControl x:Class="Dynasland.App.Views.Hub.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hub="clr-namespace:Dynasland.App.ViewModels.Hub"
             xmlns:converters="clr-namespace:Dynasland.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=hub:CalendarPageViewModel}"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVisibility" />

        <!-- Dia do calendário: número, ponto se tiver compromisso, destaque de hoje e seleção. -->
        <Style x:Key="DayButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Cell" Background="Transparent" CornerRadius="6" Margin="2" BorderThickness="1" BorderBrush="Transparent">
                            <Grid>
                                <TextBlock x:Name="Number" Text="{Binding DayNumber}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource SettingsTextBrush}" />
                                <Ellipse Width="5" Height="5" Fill="{DynamicResource SettingsAccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                         Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource SettingsCardHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource SettingsTertiaryTextBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Number" Property="FontWeight" Value="Bold" />
                                <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource SettingsAccentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}" />
                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource SettingsCardBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,16">
            <TextBlock Text="Agenda" Style="{StaticResource SettingsTitle}" />
            <TextBlock Text="Compromissos guardados neste computador, com lembretes na ilha." Style="{StaticResource SettingsSubtitle}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Calendário mensal -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource SettingsCard}" Padding="12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource HubIconButton}" Content="&#xE76C;" ToolTip="Próximo mês" Command="{Binding NextMonthCommand}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource HubIconButton}" Content="&#xE8D1;" ToolTip="Hoje" Command="{Binding GoToTodayCommand}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource HubIconButton}" Content="&#xE76B;" ToolTip="Mês anterior" Command="{Binding PreviousMonthCommand}" />
                        <TextBlock Text="{Binding MonthTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Source={x:Static hub:CalendarPageViewModel.WeekDays}}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" HorizontalAlignment="Center" Style="{StaticResource CardDescription}" Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Days}" Focusable="False" Height="252">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type hub:CalendarDayViewModel}">
                                <Button Style="{StaticResource DayButton}" Command="{Binding Select}" ToolTip="{Binding Tooltip}"
                                        AutomationProperties.Name="{Binding Date, StringFormat=dd/MM/yyyy}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="Próximos 14 dias" Style="{StaticResource SettingsGroupHeader}" />
            <ItemsControl ItemsSource="{Binding Upcoming}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type hub:CalendarEventItemViewModel}">
                        <TextBlock Margin="4,2" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Event.StartsAt.LocalDateTime, Mode=OneWay, StringFormat=dd/MM}" Foreground="{DynamicResource SettingsTertiaryTextBrush}" />
                            <Run Text="{Binding Title, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Dia selecionado e edição -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="18,0,0,0">
            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource InvertedBoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Novo compromisso" Command="{Binding NewCommand}" />
                    <TextBlock Text="{Binding SelectedDateTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                </DockPanel>
                <TextBlock Text="Nenhum compromisso neste dia." Style="{StaticResource CardDescription}" Margin="0,14,0,0"
                           Visibility="{Binding HasDayEvents, Converter={StaticResource InvertedBoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding DayEvents}" Focusable="False" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type hub:CalendarEventItemViewModel}">
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource CardDescription}">
                                            <Run Text="{Binding TimeText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding ReminderText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Notes}" Style="{StaticResource CardDescription}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource HubIconButton}" Content="&#xE70F;" ToolTip="Editar" Command="{Binding Edit}" />
                                        <Button Style="{StaticResource HubIconButton}" Content="&#xE74D;" ToolTip="Excluir" Command="{Binding Delete}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Formulário -->
            <Border Style="{StaticResource SettingsCard}" VerticalAlignment="Top" Padding="16"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedDateTitle}" Style="{StaticResource CardDescription}" Margin="0,2,0,12" />

                    <TextBlock Text="Título" Style="{StaticResource CardDescription}" />
                    <TextBox Style="{StaticResource SettingsTextBox}" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"
                             AutomationProperties.Name="Título do compromisso" />

                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EditAllDay}" Content="Dia inteiro" HorizontalAlignment="Left" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,10" Visibility="{Binding EditAllDay, Converter={StaticResource InvertedBoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Início (HH:mm)" Style="{StaticResource CardDescription}" />
                            <TextBox Style="{StaticResource SettingsTextBox}" Text="{Binding EditStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                                     AutomationProperties.Name="Horário de início" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fim (HH:mm)" Style="{StaticResource CardDescription}" />
                            <TextBox Style="{StaticResource SettingsTextBox}" Text="{Binding EditEnd, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"
                                     AutomationProperties.Name="Horário de término" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Lembrete" Style="{StaticResource CardDescription}" />
                    <ComboBox ItemsSource="{Binding Source={x:Static hub:CalendarPageViewModel.Reminders}}" SelectedItem="{Binding EditReminder}"
                              DisplayMemberPath="Name" Margin="0,4,0,10" AutomationProperties.Name="Lembrete" />

                    <TextBlock Text="Observações" Style="{StaticResource CardDescription}" />
                    <TextBox Style="{StaticResource SettingsTextBox}" Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" VerticalContentAlignment="Top" AutomationProperties.Name="Observações" />

                    <TextBlock Text="{Binding EditError}" Foreground="{DynamicResource StatusFailedBrush}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SettingsButton}" Content="Cancelar" Command="{Binding CancelEditCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource AccentButton}" Content="Salvar" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
