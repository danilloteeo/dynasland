<Window
             xmlns:controls="clr-namespace:Dynasland.App.Controls" x:Class="Dynasland.App.Views.HubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hub="clr-namespace:Dynasland.App.ViewModels.Hub"
        xmlns:views="clr-namespace:Dynasland.App.Views.Hub"
        xmlns:converters="clr-namespace:Dynasland.App.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=hub:HubViewModel}"
        Title="Central do Dynasland"
        Width="980" Height="680" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SettingsBackgroundBrush}"
        Foreground="{DynamicResource SettingsTextBrush}"
        FontFamily="{StaticResource IslandTextFont}"
        UseLayoutRounding="True">

    <Window.Resources>
        <converters:EnumMatchConverter x:Key="EnumMatch" />

        <!-- Cada página é escolhida pelo tipo do view model. -->
        <DataTemplate DataType="{x:Type hub:ClipboardPageViewModel}">
            <views:ClipboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type hub:FocusPageViewModel}">
            <views:FocusPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type hub:NotificationsPageViewModel}">
            <views:NotificationsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type hub:CalendarPageViewModel}">
            <views:CalendarPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type hub:CapturesPageViewModel}">
            <views:CapturesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type hub:WaterPageViewModel}">
            <views:WaterPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SettingsSidebarBrush}">
            <DockPanel Margin="14,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="52" Margin="8,0,0,6">
                    <controls:PixelMascot Width="28" Height="14" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource SettingsTextBrush}" />
                    <TextBlock Text="Central" FontSize="14" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" Tag="vector:clipboard" Content="Área de transferência"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Clipboard}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="vector:bell" Content="Notificações"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Notifications}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="vector:calendar" Content="Agenda"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Calendar}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="vector:focus" Content="Foco"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Focus}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="vector:capture" Content="Capturas"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Captures}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="vector:water" Content="Água"
                                 IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Water}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding Current}" Focusable="False" Margin="32,24,28,24" />
    </Grid>
</Window>
