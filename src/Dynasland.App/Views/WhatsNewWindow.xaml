<Window x:Class="Dynasland.App.Views.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Dynasland.App.Controls"
        Title="Novidades do Dynasland"
        Width="400" Height="380"
        ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SettingsBackgroundBrush}"
        Foreground="{DynamicResource SettingsTextBrush}"
        FontFamily="{StaticResource IslandTextFont}"
        UseLayoutRounding="True">

    <!-- Novidades depois de atualizar, no formato do Volum: mascote, uma frase por página, pontos e "Próximo". -->
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PixelMascot Width="84" Height="42" HorizontalAlignment="Left"
                              TextElement.Foreground="{DynamicResource SettingsTextBrush}" />

        <StackPanel x:Name="PageContent" Grid.Row="1" Margin="0,22,0,0">
            <TextBlock x:Name="PageTitle" Style="{StaticResource SettingsTitle}" FontSize="22" TextWrapping="Wrap" />
            <TextBlock x:Name="PageText" Style="{StaticResource SettingsSubtitle}" FontSize="14" Margin="0,10,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="2">
            <Button x:Name="NextButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" MinWidth="96" Click="OnNext" />
            <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
