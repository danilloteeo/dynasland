<UserControl x:Class="Dynasland.App.Views.Settings.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dynasland.App.ViewModels"
             xmlns:controls="clr-namespace:Dynasland.App.Controls"
             xmlns:converters="clr-namespace:Dynasland.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:EnumMatchConverter x:Key="EnumMatch" />
        <converters:EnumMatchToVisibilityConverter x:Key="EnumVisibility" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVisibility" />
        <Style x:Key="SettingRowGrid" TargetType="Grid">
            <Setter Property="MinHeight" Value="36" />
        </Style>
    </UserControl.Resources>

    <StackPanel>

            <TextBlock Text="Aparência" Style="{StaticResource SettingsTitle}" />
            <TextBlock Text="Tema das janelas, cor de destaque e o visual da ilha."
                       Style="{StaticResource SettingsSubtitle}" Margin="0,6,0,0" />

            <TextBlock Text="TEMA" Style="{StaticResource SettingsGroupHeader}" />
            <controls:SegmentedControl Width="330" HorizontalAlignment="Left" Margin="0,0,0,6">
                <UniformGrid Rows="1">
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="Theme" Content="Automático" AutomationProperties.Name="Automático"
                                 IsChecked="{Binding Theme, Converter={StaticResource EnumMatch}, ConverterParameter=System}" />
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="Theme" Content="Escuro" AutomationProperties.Name="Escuro"
                                 IsChecked="{Binding Theme, Converter={StaticResource EnumMatch}, ConverterParameter=Dark}" />
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="Theme" Content="Claro" AutomationProperties.Name="Claro"
                                 IsChecked="{Binding Theme, Converter={StaticResource EnumMatch}, ConverterParameter=Light}" />
                </UniformGrid>
            </controls:SegmentedControl>
            <TextBlock Text="Automático segue o modo de cor dos aplicativos do Windows." Style="{StaticResource CardDescription}" />

            <TextBlock Text="COR DE DESTAQUE" Style="{StaticResource SettingsGroupHeader}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Usada no equalizador, carregamento, botões e controles." Style="{StaticResource CardDescription}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding AccentOptions}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AccentOptionViewModel}">
                                <RadioButton Style="{StaticResource AccentSwatch}" GroupName="Accent" Background="{Binding Brush}"
                                             IsChecked="{Binding IsSelected}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="TEMA DA ILHA" Style="{StaticResource SettingsGroupHeader}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="Fundo da ilha. Todos são escuros, para o texto continuar legível." Style="{StaticResource CardDescription}" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding IslandThemeOptions}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:IslandThemeOptionViewModel}">
                                <RadioButton Style="{StaticResource IslandThemeSwatch}" GroupName="IslandTheme" Background="{Binding Brush}"
                                             Content="{Binding Name}" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingRowGrid}">
                    <StackPanel Margin="0,0,180,0">
                        <TextBlock Text="Seguir a cor da música" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Enquanto uma música ou vídeo toca, o fundo da ilha usa a cor da capa. Ao parar, volta ao tema escolhido."
                                   Style="{StaticResource CardDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding IslandThemeFollowsMedia}"
                              AutomationProperties.Name="Seguir a cor da música" />
                </Grid>
            </Border>

            <TextBlock Text="ILHA EM REPOUSO" Style="{StaticResource SettingsGroupHeader}" />
            <RadioButton Style="{StaticResource OptionRow}" GroupName="IdleDisplay" AutomationProperties.Name="Data e hora"
                         IsChecked="{Binding IdleDisplay, Converter={StaticResource EnumMatch}, ConverterParameter=DateAndTime}">
                <StackPanel>
                    <TextBlock Text="Data e hora" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="O que a ilha mostra quando nenhum módulo tem algo a exibir." Style="{StaticResource CardDescription}" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource OptionRow}" GroupName="IdleDisplay" AutomationProperties.Name="Só a hora"
                         IsChecked="{Binding IdleDisplay, Converter={StaticResource EnumMatch}, ConverterParameter=TimeOnly}">
                <TextBlock Text="Só a hora" Style="{StaticResource CardTitle}" />
            </RadioButton>
            <RadioButton Style="{StaticResource OptionRow}" GroupName="IdleDisplay" AutomationProperties.Name="Clima e hora"
                         IsChecked="{Binding IdleDisplay, Converter={StaticResource EnumMatch}, ConverterParameter=Weather}">
                <StackPanel>
                    <TextBlock Text="Clima e hora" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Temperatura e condição agora. Sem cidade escolhida ou sem previsão, mostra a data." Style="{StaticResource CardDescription}" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource OptionRow}" GroupName="IdleDisplay" AutomationProperties.Name="Próximo compromisso e hora"
                         IsChecked="{Binding IdleDisplay, Converter={StaticResource EnumMatch}, ConverterParameter=NextEvent}">
                <StackPanel>
                    <TextBlock Text="Próximo compromisso e hora" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="O próximo item da agenda. Sem compromisso próximo, mostra a data." Style="{StaticResource CardDescription}" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource OptionRow}" GroupName="IdleDisplay" AutomationProperties.Name="Rede e hora"
                         IsChecked="{Binding IdleDisplay, Converter={StaticResource EnumMatch}, ConverterParameter=Network}">
                <StackPanel>
                    <TextBlock Text="Rede e hora" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Velocidade de download e upload ao vivo. Precisa do módulo Monitor do sistema ligado." Style="{StaticResource CardDescription}" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource OptionRow}" GroupName="IdleDisplay" AutomationProperties.Name="Nada"
                         IsChecked="{Binding IdleDisplay, Converter={StaticResource EnumMatch}, ConverterParameter=Nothing}">
                <StackPanel>
                    <TextBlock Text="Nada" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="A ilha fica vazia, só com o fundo do tema." Style="{StaticResource CardDescription}" />
                </StackPanel>
            </RadioButton>

            <TextBlock Text="ILHA" Style="{StaticResource SettingsGroupHeader}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Opacidade" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding IslandOpacity, StringFormat={}{0:P0} opaca}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <Slider Grid.Column="1" Style="{StaticResource SettingsSlider}" Minimum="0.5" Maximum="1" VerticalAlignment="Center"
                            Value="{Binding IslandOpacity, Delay=200}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Sombra" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding ShadowIntensity, StringFormat={}{0:P0}}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <Slider Grid.Column="1" Style="{StaticResource SettingsSlider}" Minimum="0" Maximum="1" VerticalAlignment="Center"
                            Value="{Binding ShadowIntensity, Delay=200}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Arredondamento" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding Roundness, StringFormat='{}{0:P0} (100% = cápsula)'}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <Slider Grid.Column="1" Style="{StaticResource SettingsSlider}" Minimum="0.3" Maximum="1" VerticalAlignment="Center"
                            Value="{Binding Roundness, Delay=200}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Largura mínima" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding CompactWidth, StringFormat=Ilha compacta: {0:0} px}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <Slider Grid.Column="1" Style="{StaticResource SettingsSlider}" Minimum="140" Maximum="300" VerticalAlignment="Center"
                            Value="{Binding CompactWidth, Delay=200}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Largura máxima" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding MaxWidth, StringFormat=Ilha expandida: até {0:0} px}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <Slider Grid.Column="1" Style="{StaticResource SettingsSlider}" Minimum="340" Maximum="420" VerticalAlignment="Center"
                            Value="{Binding MaxWidth, Delay=200}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Altura da ilha" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding CompactHeight, StringFormat=Ilha compacta: {0:0} px}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <Slider Grid.Column="1" Style="{StaticResource SettingsSlider}" Minimum="28" Maximum="44" VerticalAlignment="Center"
                            Value="{Binding CompactHeight, Delay=200}" />
                </Grid>
            </Border>
    </StackPanel>
</UserControl>
