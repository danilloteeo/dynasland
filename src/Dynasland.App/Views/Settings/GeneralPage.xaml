<UserControl x:Class="Dynasland.App.Views.Settings.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dynasland.App.ViewModels"
             xmlns:converters="clr-namespace:Dynasland.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:EnumMatchConverter x:Key="EnumMatch" />
        <converters:EnumMatchToVisibilityConverter x:Key="EnumVisibility" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVisibility" />
        <Style x:Key="SettingRowGrid" TargetType="Grid">
            <Setter Property="MinHeight" Value="36" />
        </Style>
    </UserControl.Resources>

    <StackPanel>

            <TextBlock Text="Geral" Style="{StaticResource SettingsTitle}" />
            <TextBlock Text="Inicialização e visibilidade da ilha." Style="{StaticResource SettingsSubtitle}" Margin="0,6,0,0" />

            <TextBlock Text="Inicialização" Style="{StaticResource SettingsGroupHeader}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingRowGrid}">
                    <StackPanel Margin="0,0,180,0">
                        <TextBlock Text="Iniciar com o Windows" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Abre o Dynasland automaticamente ao entrar no Windows." Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding StartWithWindows}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingRowGrid}">
                    <StackPanel Margin="0,0,180,0">
                        <TextBlock Text="Iniciar minimizado" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Abre com a ilha oculta, só com o ícone na bandeja. Mostre pela bandeja quando quiser." Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding StartHidden}" />
                </Grid>
            </Border>

            <TextBlock Text="Ilha" Style="{StaticResource SettingsGroupHeader}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingRowGrid}">
                    <StackPanel Margin="0,0,180,0">
                        <TextBlock Text="Mostrar a ilha" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Oculta a ilha sem fechar o Dynasland." Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding IsIslandVisible}" />
                </Grid>
            </Border>

        <TextBlock Text="Clima" Style="{StaticResource SettingsGroupHeader}" />
        <Border Style="{StaticResource SettingsCard}">
            <StackPanel>
                <Grid>
                    <StackPanel Margin="0,0,160,0">
                        <TextBlock Text="{Binding Weather.CurrentLocation, TargetNullValue=Nenhuma cidade escolhida}" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource CardDescription}" TextWrapping="Wrap"
                                   Text="{Binding Weather.ProviderName, StringFormat=Previsão gratuita do {0}. Só as coordenadas da cidade são enviadas.}" />
                    </StackPanel>
                    <Button Style="{StaticResource SettingsButton}" Content="Desligar clima" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding Weather.ClearCommand}" Visibility="{Binding Weather.HasLocation, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <DockPanel Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SettingsButton}" Content="Buscar" Margin="8,0,0,0" Command="{Binding Weather.SearchCommand}" IsDefault="True" />
                    <TextBox Style="{StaticResource SettingsTextBox}" Tag="Digite o nome da cidade…" Text="{Binding Weather.Query, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Cidade da previsão do tempo" />
                </DockPanel>
                <TextBlock Text="{Binding Weather.SearchMessage}" Style="{StaticResource CardDescription}" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{Binding Weather.Results}" Focusable="False" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SettingsButton}" Content="{Binding Name}" Command="{Binding Select}" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Margin="0,3,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
