<UserControl x:Class="Dynasland.App.Views.Settings.ShortcutsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dynasland.App.ViewModels"
             xmlns:converters="clr-namespace:Dynasland.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:EnumMatchConverter x:Key="EnumMatch" />
        <converters:EnumMatchToVisibilityConverter x:Key="EnumVisibility" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVisibility" />
        <Style x:Key="SettingRowGrid" TargetType="Grid">
            <Setter Property="MinHeight" Value="36" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Atalhos" Style="{StaticResource SettingsTitle}" />
        <TextBlock Text="Combinações de teclas que funcionam com qualquer programa em foco. Clique em uma combinação e pressione a nova." Style="{StaticResource SettingsSubtitle}" TextWrapping="Wrap" Margin="0,6,0,0" />
        <TextBlock Text="{Binding Shortcuts.Message}" Style="{StaticResource CardDescription}" Margin="4,14,0,0" FontSize="13"
                   Foreground="{DynamicResource SettingsAccentBrush}" />
        <ItemsControl ItemsSource="{Binding Shortcuts.Items}" Focusable="False" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SettingsCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Label, Mode=OneWay}" />
                                    <Run Text="{Binding Category, Mode=OneWay, StringFormat=  · {0}}" Foreground="{DynamicResource SettingsTertiaryTextBrush}" FontSize="12" />
                                </TextBlock>
                                <TextBlock Text="{Binding DefaultText}" Style="{StaticResource CardDescription}" />
                                <TextBlock Text="{Binding Error}" Style="{StaticResource CardDescription}" Foreground="{DynamicResource StatusFailedBrush}"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="GestureButton" Style="{StaticResource SettingsButton}" MinWidth="150" Content="{Binding GestureText}"
                                        Command="{Binding RecordCommand}" ToolTip="Clique e pressione a nova combinação" />
                                <Button Style="{StaticResource HubIconButton}" Content="&#xE711;" ToolTip="Remover o atalho" Margin="6,0,0,0"
                                        Command="{Binding ClearCommand}" Visibility="{Binding HasGesture, Converter={StaticResource BoolToVisibility}}" />
                                <Button Style="{StaticResource HubIconButton}" Content="&#xE777;" ToolTip="Voltar ao padrão" Margin="2,0,0,0"
                                        Command="{Binding ResetCommand}" Visibility="{Binding CanReset, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                            <Setter TargetName="GestureButton" Property="Content" Value="Pressione…" />
                            <Setter TargetName="GestureButton" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
