<UserControl x:Class="Dynasland.App.Views.Settings.NotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dynasland.App.ViewModels"
             xmlns:converters="clr-namespace:Dynasland.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:EnumMatchConverter x:Key="EnumMatch" />
        <converters:EnumMatchToVisibilityConverter x:Key="EnumVisibility" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVisibility" />
        <Style x:Key="SettingRowGrid" TargetType="Grid">
            <Setter Property="MinHeight" Value="36" />
        </Style>
    </UserControl.Resources>

    <StackPanel>

            <TextBlock Text="Notificações" Style="{StaticResource SettingsTitle}" />
            <TextBlock Text="Quais aplicativos aparecem na ilha e como. O Windows continua exibindo as notificações normalmente."
                       Style="{StaticResource SettingsSubtitle}" Margin="0,6,0,0" />

            <TextBlock Text="Aplicativos permitidos" Style="{StaticResource SettingsGroupHeader}" />
            <RadioButton Style="{StaticResource OptionRow}" GroupName="NotificationMode" AutomationProperties.Name="Todos, exceto os bloqueados"
                         IsChecked="{Binding NotificationMode, Converter={StaticResource EnumMatch}, ConverterParameter=AllExceptBlocked}">
                <StackPanel>
                    <TextBlock Text="Todos, exceto os bloqueados" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Aplicativos novos aparecem na ilha até você desligá-los." Style="{StaticResource CardDescription}" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource OptionRow}" GroupName="NotificationMode" AutomationProperties.Name="Somente os permitidos"
                         IsChecked="{Binding NotificationMode, Converter={StaticResource EnumMatch}, ConverterParameter=OnlyAllowed}">
                <StackPanel>
                    <TextBlock Text="Somente os permitidos" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Apenas os aplicativos ligados abaixo aparecem na ilha." Style="{StaticResource CardDescription}" />
                </StackPanel>
            </RadioButton>

            <TextBlock Text="Exibição" Style="{StaticResource SettingsGroupHeader}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingRowGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Duração" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding NotificationDuration, StringFormat=Cada notificação fica {0:0} s na ilha}" Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <Slider Grid.Column="1" Style="{StaticResource SettingsSlider}" Minimum="2" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" Value="{Binding NotificationDuration, Delay=250}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingsCard}">
                <Grid Style="{StaticResource SettingRowGrid}">
                    <StackPanel Margin="0,0,180,0">
                        <TextBlock Text="Prioridade alta" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Ligado, notificações interrompem a ilha mesmo enquanto você usa um controle ou painel." Style="{StaticResource CardDescription}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding NotificationsCanInterrupt}" />
                </Grid>
            </Border>

            <TextBlock Text="Aplicativos" Style="{StaticResource SettingsGroupHeader}" />
            <Border Style="{StaticResource SettingsCard}" Visibility="{Binding HasNotificationApps, Converter={StaticResource InvertedBoolToVisibility}}">
                <TextBlock Text="Os aplicativos aparecem aqui depois de enviarem a primeira notificação." Style="{StaticResource CardDescription}" />
            </Border>
            <ItemsControl ItemsSource="{Binding NotificationApps}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NotificationAppViewModel}">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Margin="0,0,220,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Segue a opção acima" Style="{StaticResource CardDescription}"
                                                   Visibility="{Binding FollowsMode, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource HubIconButton}" Content="vector:gear" ToolTip="Opções deste aplicativo" Margin="0,0,10,0"
                                                Command="{Binding ToggleExpandedCommand}" />
                                        <CheckBox Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" IsChecked="{Binding Shows}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat=Permitir {0}}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <Grid Margin="0,4">
                                        <TextBlock Text="Só no histórico (não aparece na ilha)" Style="{StaticResource CardDescription}" VerticalAlignment="Center" />
                                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding HistoryOnly}" />
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <TextBlock Text="Prioridade alta (interrompe a ilha em uso)" Style="{StaticResource CardDescription}" VerticalAlignment="Center" />
                                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding HighPriority}" />
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <TextBlock Text="Duração própria" Style="{StaticResource CardDescription}" VerticalAlignment="Center" />
                                        <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding HasCustomDuration}" />
                                    </Grid>
                                    <Grid Margin="0,4" Visibility="{Binding HasCustomDuration, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="240" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DurationSeconds, StringFormat={}{0:0} s na ilha}" Style="{StaticResource CardDescription}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Style="{StaticResource SettingsSlider}" Minimum="2" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding DurationSeconds, Delay=300}" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
    </StackPanel>
</UserControl>
