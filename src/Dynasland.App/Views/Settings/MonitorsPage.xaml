<UserControl x:Class="Dynasland.App.Views.Settings.MonitorsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dynasland.App.ViewModels"
             xmlns:controls="clr-namespace:Dynasland.App.Controls"
             xmlns:converters="clr-namespace:Dynasland.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:EnumMatchConverter x:Key="EnumMatch" />
        <converters:EnumMatchToVisibilityConverter x:Key="EnumVisibility" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVisibility" />
        <Style x:Key="SettingRowGrid" TargetType="Grid">
            <Setter Property="MinHeight" Value="36" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Monitores" Style="{StaticResource SettingsTitle}" />
        <TextBlock Text="Em qual monitor a ilha aparece, em que lado do topo e com qual formato. A posição é recalculada sozinha ao mudar resolução, escala ou monitores." Style="{StaticResource SettingsSubtitle}" TextWrapping="Wrap" Margin="0,6,0,0" />
        <TextBlock Text="POSIÇÃO DA ILHA" Style="{StaticResource SettingsGroupHeader}" />
        <Border Style="{StaticResource SettingsCard}">
            <Grid Style="{StaticResource SettingRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Posição" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Nas laterais, cresce a partir da borda." Style="{StaticResource CardDescription}" />
                </StackPanel>
                <controls:SegmentedControl Grid.Column="1" VerticalAlignment="Center">
                    <UniformGrid Rows="1">
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="IslandPosition" Content="Esquerda" AutomationProperties.Name="Esquerda"
                                     IsChecked="{Binding Position, Converter={StaticResource EnumMatch}, ConverterParameter=Left}" />
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="IslandPosition" Content="Centro" AutomationProperties.Name="Centro"
                                     IsChecked="{Binding Position, Converter={StaticResource EnumMatch}, ConverterParameter=Center}" />
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="IslandPosition" Content="Direita" AutomationProperties.Name="Direita"
                                     IsChecked="{Binding Position, Converter={StaticResource EnumMatch}, ConverterParameter=Right}" />
                    </UniformGrid>
                </controls:SegmentedControl>
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingsCard}">
            <Grid Style="{StaticResource SettingRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Formato" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Encaixada cola no topo, cantos de cima retos." Style="{StaticResource CardDescription}" />
                </StackPanel>
                <controls:SegmentedControl Grid.Column="1" VerticalAlignment="Center">
                    <UniformGrid Rows="1">
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="IslandShape" Content="Flutuante" AutomationProperties.Name="Flutuante"
                                     IsChecked="{Binding Shape, Converter={StaticResource EnumMatch}, ConverterParameter=Float}" />
                        <RadioButton Style="{StaticResource SegmentItem}" GroupName="IslandShape" Content="Encaixada" AutomationProperties.Name="Encaixada"
                                     IsChecked="{Binding Shape, Converter={StaticResource EnumMatch}, ConverterParameter=Notch}" />
                    </UniformGrid>
                </controls:SegmentedControl>
            </Grid>
        </Border>
        <!-- A ilha encaixada não tem distância do topo. -->
        <Border Style="{StaticResource SettingsCard}"
                IsEnabled="{Binding Shape, Converter={StaticResource EnumMatch}, ConverterParameter=Float}">
            <Grid Style="{StaticResource SettingRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Distância do topo" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding TopMargin, StringFormat={}{0:0} px}" Style="{StaticResource CardDescription}" />
                </StackPanel>
                <Slider Grid.Column="1" Style="{StaticResource SettingsSlider}" Minimum="0" Maximum="60" VerticalAlignment="Center"
                        Value="{Binding TopMargin, Delay=250}" />
            </Grid>
        </Border>

        <TextBlock Text="EXIBIR NO MONITOR" Style="{StaticResource SettingsGroupHeader}" />
        <ItemsControl ItemsSource="{Binding MonitorOptions}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MonitorOptionViewModel}">
                    <RadioButton Style="{StaticResource OptionRow}" GroupName="Monitor" IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDescription}" />
                        </StackPanel>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
