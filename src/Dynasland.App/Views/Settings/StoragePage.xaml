<UserControl x:Class="Dynasland.App.Views.Settings.StoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dynasland.App.ViewModels"
             xmlns:converters="clr-namespace:Dynasland.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:EnumMatchConverter x:Key="EnumMatch" />
        <converters:EnumMatchToVisibilityConverter x:Key="EnumVisibility" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVisibility" />
        <Style x:Key="SettingRowGrid" TargetType="Grid">
            <Setter Property="MinHeight" Value="36" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Armazenamento" Style="{StaticResource SettingsTitle}" />
        <TextBlock Text="Quanto o Dynasland guarda, cópia de segurança das configurações e pastas de dados." Style="{StaticResource SettingsSubtitle}" TextWrapping="Wrap" Margin="0,6,0,0" />
        <TextBlock Text="BANCO DE DADOS" Style="{StaticResource SettingsGroupHeader}" />
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <StackPanel Margin="0,0,200,0">
                    <TextBlock Text="{Binding Storage.DatabaseSize, StringFormat=Tamanho atual: {0}}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding Storage.DatabasePath}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource SettingsTertiaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Style="{StaticResource SettingsButton}" Content="Compactar" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding Storage.CompactCommand}" ToolTip="Aplica os limites abaixo e recupera o espaço de itens apagados" />
            </Grid>
        </Border>
        <TextBlock Text="RETENÇÃO DOS HISTÓRICOS" Style="{StaticResource SettingsGroupHeader}" />
        <Border Style="{StaticResource SettingsCard}">
            <Grid Style="{StaticResource SettingRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Itens da área de transferência" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding Storage.ClipboardMaxItems, StringFormat=Mantém os {0:0} mais recentes (favoritos não contam)}" Style="{StaticResource CardDescription}" />
                </StackPanel>
                <Slider Grid.Column="1" Style="{StaticResource SettingsSlider}" Minimum="20" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" Value="{Binding Storage.ClipboardMaxItems, Delay=300}" />
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingsCard}">
            <Grid Style="{StaticResource SettingRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Notificações" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="{Binding Storage.NotificationHistoryDays, StringFormat=Guardadas por {0:0} dias}" Style="{StaticResource CardDescription}" />
                </StackPanel>
                <Slider Grid.Column="1" Style="{StaticResource SettingsSlider}" Minimum="1" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" Value="{Binding Storage.NotificationHistoryDays, Delay=300}" />
            </Grid>
        </Border>
        <TextBlock Text="CÓPIA DE SEGURANÇA" Style="{StaticResource SettingsGroupHeader}" />
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <StackPanel Margin="0,0,200,0">
                    <TextBlock Text="Exportar configurações" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Salva aparência, comportamento, módulos, notificações e atalhos num arquivo JSON (sem históricos)." Style="{StaticResource CardDescription}" />
                </StackPanel>
                <Button Style="{StaticResource SettingsButton}" Content="Exportar…" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnExportClick" />
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <StackPanel Margin="0,0,200,0">
                    <TextBlock Text="Importar configurações" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Substitui as configurações atuais pelas do arquivo. Uma cópia automática também é feita a cada início." Style="{StaticResource CardDescription}" />
                </StackPanel>
                <Button Style="{StaticResource SettingsButton}" Content="Importar…" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnImportClick" />
            </Grid>
        </Border>
        <TextBlock Text="PASTAS" Style="{StaticResource SettingsGroupHeader}" />
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <StackPanel Margin="0,0,200,0">
                    <TextBlock Text="Pasta de dados" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Banco de dados e cópia automática das configurações." Style="{StaticResource CardDescription}" />
                </StackPanel>
                <Button Style="{StaticResource SettingsButton}" Content="Abrir pasta" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding Storage.OpenDataFolderCommand}" />
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <StackPanel Margin="0,0,160,0">
                    <TextBlock Text="Registro de diagnóstico" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Ajuda a investigar problemas. Não contém conteúdo de notificações nem da área de transferência." Style="{StaticResource CardDescription}" />
                </StackPanel>
                <Button Style="{StaticResource SettingsButton}" Content="Abrir pasta" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding Storage.OpenLogsFolderCommand}" />
            </Grid>
        </Border>

        <TextBlock Text="{Binding Storage.LastAction}" Style="{StaticResource CardDescription}" Margin="4,10,0,0" />
    </StackPanel>
</UserControl>
