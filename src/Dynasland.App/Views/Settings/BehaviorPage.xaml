<UserControl x:Class="Dynasland.App.Views.Settings.BehaviorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Dynasland.App.ViewModels"
             xmlns:converters="clr-namespace:Dynasland.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:EnumMatchConverter x:Key="EnumMatch" />
        <converters:EnumMatchToVisibilityConverter x:Key="EnumVisibility" />
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBoolToVisibility" />
        <Style x:Key="SettingRowGrid" TargetType="Grid">
            <Setter Property="MinHeight" Value="36" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Comportamento" Style="{StaticResource SettingsTitle}" />
        <TextBlock Text="Como a ilha responde a cliques, a programas em tela cheia e ao módulo fixado." Style="{StaticResource SettingsSubtitle}" TextWrapping="Wrap" Margin="0,6,0,0" />
        <TextBlock Text="CLIQUES" Style="{StaticResource SettingsGroupHeader}" />
        <Border Style="{StaticResource SettingsCard}">
            <Grid Style="{StaticResource SettingRowGrid}">
                <StackPanel Margin="0,0,180,0">
                    <TextBlock Text="Recolher ao clicar fora" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Com a ilha aberta, um clique em qualquer outro lugar a fecha." Style="{StaticResource CardDescription}" />
                </StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding Behavior.CollapseOnClickOutside}" />
            </Grid>
        </Border>
        <TextBlock Text="DUPLO CLIQUE NA ILHA" Style="{StaticResource SettingsGroupHeader}" />
        <RadioButton Style="{StaticResource OptionRow}" GroupName="DoubleClick" AutomationProperties.Name="Nenhuma ação"
                     IsChecked="{Binding Behavior.DoubleClickAction, Converter={StaticResource EnumMatch}, ConverterParameter=None}">
            <StackPanel>
                <TextBlock Text="Nenhuma ação" Style="{StaticResource CardTitle}" />
                <TextBlock Text="O clique simples abre a ilha na hora." Style="{StaticResource CardDescription}" />
            </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource OptionRow}" GroupName="DoubleClick" AutomationProperties.Name="Reproduzir/pausar mídia"
                     IsChecked="{Binding Behavior.DoubleClickAction, Converter={StaticResource EnumMatch}, ConverterParameter=PlayPauseMedia}">
            <StackPanel>
                <TextBlock Text="Reproduzir/pausar mídia" Style="{StaticResource CardTitle}" />
                <TextBlock Text="Age na mídia atual do Windows. O clique simples passa a esperar um instante." Style="{StaticResource CardDescription}" />
            </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource OptionRow}" GroupName="DoubleClick" AutomationProperties.Name="Abrir configurações"
                     IsChecked="{Binding Behavior.DoubleClickAction, Converter={StaticResource EnumMatch}, ConverterParameter=OpenSettings}">
            <StackPanel>
                <TextBlock Text="Abrir configurações" Style="{StaticResource CardTitle}" />
                <TextBlock Text="O clique simples passa a esperar um instante." Style="{StaticResource CardDescription}" />
            </StackPanel>
        </RadioButton>
        <TextBlock Text="TELA CHEIA" Style="{StaticResource SettingsGroupHeader}" />
        <Border Style="{StaticResource SettingsCard}">
            <Grid Style="{StaticResource SettingRowGrid}">
                <StackPanel Margin="0,0,180,0">
                    <TextBlock Text="Ocultar em tela cheia" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Esconde a ilha enquanto um jogo, vídeo ou apresentação ocupa o monitor dela." Style="{StaticResource CardDescription}" />
                </StackPanel>
                <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding HideInFullscreen}" />
            </Grid>
        </Border>

        <TextBlock Text="MÓDULO FIXADO" Style="{StaticResource SettingsGroupHeader}" />
        <Border Style="{StaticResource SettingsCard}">
            <Grid>
                <StackPanel Margin="0,0,180,0">
                    <TextBlock Text="{Binding Behavior.PinnedModuleName, FallbackValue=Nenhum, TargetNullValue=Nenhum}" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="O módulo fixado fica sempre no compacto, à frente dos outros. Fixe pelo botão de alfinete na ilha aberta." Style="{StaticResource CardDescription}" />
                </StackPanel>
                <Button Style="{StaticResource SettingsButton}" Content="Desafixar" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding Behavior.UnpinCommand}" Visibility="{Binding Behavior.HasPinnedModule, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
