<Window x:Class="Dynasland.App.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Dynasland.App.ViewModels"
        xmlns:views="clr-namespace:Dynasland.App.Views"
        xmlns:converters="clr-namespace:Dynasland.App.Converters"
        xmlns:common="clr-namespace:Dynasland.Modules.Common;assembly=Dynasland.Modules"
        xmlns:models="clr-namespace:Dynasland.Core.Models;assembly=Dynasland.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:IslandViewModel}"
        x:Name="Root"
        Title="Dynasland"
        Width="600"
        Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        UseLayoutRounding="True">

    <!--
        A janela tem tamanho fixo (IslandLayout.Maximum + rodapé + folga para overshoot e sombra) e é
        totalmente transparente: pixels com alfa 0 deixam os cliques passarem para o que está atrás.
        Apenas a cápsula (IslandHost) é animada, evitando redimensionar o HWND a cada frame.
    -->
    <Window.Resources>
        <common:GlyphContentConverter x:Key="GlyphContent" />
        <converters:RingDashConverter x:Key="RingDash" />
        <views:ActivityTemplateSelector x:Key="CompactTemplates" Mode="{x:Static models:IslandState.Compact}" />
        <views:ActivityTemplateSelector x:Key="ExpandedTemplates" Mode="{x:Static models:IslandState.Expanded}" />
        <views:ActivityTemplateSelector x:Key="InteractiveTemplates" Mode="{x:Static models:IslandState.Interactive}" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="LayerStyle" TargetType="ContentPresenter">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- Seta de página: círculo de 22px a 10% de branco (18% no hover), com a seta em cinza que clareia, como no Volum. -->
        <Style x:Key="PageArrow" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="#FF9B9BA1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Disc" Fill="#1AFFFFFF" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Fill" Value="#2EFFFFFF" />
                                <Setter Property="Foreground" Value="#FFF5F5F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bolinha de página: 5px a 30% de branco; a da página aberta fica comprida (14px) e branca. -->
        <Style x:Key="PageDot" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" Height="14" Margin="2.5,0">
                            <Border x:Name="Dot" Width="4" Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="12" />
                                <Setter TargetName="Dot" Property="Background" Value="#FFFFFFFF" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Background" Value="#80FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Palco: entrada e saída da ilha inteira (opacidade, escala e subida), como a abertura do cartão do Volum. -->
    <Grid x:Name="Stage" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="StageScale" />
                <TranslateTransform x:Name="StageShift" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid x:Name="IslandHost"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              RenderTransformOrigin="0.5,0"
              Cursor="Hand"
              MouseEnter="OnIslandMouseEnter"
              MouseLeave="OnIslandMouseLeave"
              MouseLeftButtonUp="OnIslandMouseLeftButtonUp">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="HoverScaleTransform" />
            </Grid.RenderTransform>

            <!-- Camada separada para a sombra: o efeito não afeta a renderização do texto. -->
            <Border x:Name="ShadowBorder" Background="{DynamicResource IslandBackgroundBrush}">
                <Border.CornerRadius>
                    <MultiBinding Converter="{StaticResource IslandCornerRadius}">
                        <Binding Path="CornerSize" ElementName="Root" />
                        <Binding Path="Shape" ElementName="Root" />
                    </MultiBinding>
                </Border.CornerRadius>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30"
                                      ShadowDepth="8"
                                      Direction="270"
                                      Opacity="{DynamicResource IslandShadowOpacity}"
                                      Color="Black"
                                      RenderingBias="Performance" />
                </Border.Effect>
            </Border>

            <Border Background="{DynamicResource IslandBackgroundBrush}"
                    BorderBrush="{StaticResource IslandEdgeBrush}"
                    BorderThickness="1">
                <Border.CornerRadius>
                    <MultiBinding Converter="{StaticResource IslandCornerRadius}">
                        <Binding Path="CornerSize" ElementName="Root" />
                        <Binding Path="Shape" ElementName="Root" />
                    </MultiBinding>
                </Border.CornerRadius>
                <Grid x:Name="ContentGrid" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <!-- Data e hora (só aberta). -->
                        <RowDefinition x:Name="StatusRow" Height="0" />
                        <!-- Conteúdo do módulo. -->
                        <RowDefinition Height="*" />
                        <!-- Bolinhas das páginas (só aberta, com mais de uma página). -->
                        <RowDefinition x:Name="DotsRow" Height="0" />
                    </Grid.RowDefinitions>

                    <!-- Ilha fechada: o conteúdo compacto ocupa a cápsula inteira (relógio no meio, como no Volum). -->
                    <ContentPresenter x:Name="CompactLayer" Grid.RowSpan="3"
                                      Style="{StaticResource LayerStyle}"
                                      Content="{Binding CompactContent}"
                                      ContentTemplateSelector="{StaticResource CompactTemplates}">
                        <ContentPresenter.RenderTransform>
                            <TranslateTransform />
                        </ContentPresenter.RenderTransform>
                    </ContentPresenter>

                    <!-- Pílula fechada do Volum: clima na esquerda, hora no meio e a onda (música tocando) na direita. -->
                    <Grid x:Name="ClosedPill" Grid.RowSpan="3" Margin="12,0,14,0" Opacity="0" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Esquerda: clima (ícone e temperatura). -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Visibility="{Binding HasWeather, Converter={StaticResource BoolToVisibility}}">
                            <ContentControl Content="{Binding WeatherGlyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="13"
                                            Foreground="{StaticResource IslandSecondaryTextBrush}" VerticalAlignment="Center" Focusable="False" IsTabStop="False" />
                            <TextBlock Text="{Binding WeatherTemp}" Margin="4,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                                       Foreground="{StaticResource IslandSecondaryTextBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding PillTime}" VerticalAlignment="Center" FontFamily="{DynamicResource IslandTextFont}"
                                   FontSize="14" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="14"
                                        Visibility="{Binding MusicPlaying, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Música tocando">
                                <StackPanel.Resources>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Width" Value="2.5" />
                                        <Setter Property="Margin" Value="1,0" />
                                        <Setter Property="RadiusX" Value="1.25" />
                                        <Setter Property="RadiusY" Value="1.25" />
                                        <Setter Property="Fill" Value="{DynamicResource IslandPrimaryTextBrush}" />
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                    </Style>
                                </StackPanel.Resources>
                                <Rectangle x:Name="Wave1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.35" /></Rectangle.RenderTransform></Rectangle>
                                <Rectangle x:Name="Wave2"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.75" /></Rectangle.RenderTransform></Rectangle>
                                <Rectangle x:Name="Wave3"><Rectangle.RenderTransform><ScaleTransform ScaleY="1" /></Rectangle.RenderTransform></Rectangle>
                                <Rectangle x:Name="Wave4"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.6" /></Rectangle.RenderTransform></Rectangle>
                                <Rectangle x:Name="Wave5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4" /></Rectangle.RenderTransform></Rectangle>
                                <StackPanel.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard Timeline.DesiredFrameRate="20" RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="Wave1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.5" AutoReverse="True" />
                                                <DoubleAnimation Storyboard.TargetName="Wave2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.3" Duration="0:0:0.62" AutoReverse="True" />
                                                <DoubleAnimation Storyboard.TargetName="Wave3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.45" Duration="0:0:0.42" AutoReverse="True" />
                                                <DoubleAnimation Storyboard.TargetName="Wave4" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.56" AutoReverse="True" />
                                                <DoubleAnimation Storyboard.TargetName="Wave5" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.9" Duration="0:0:0.46" AutoReverse="True" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </StackPanel.Triggers>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Aviso (estado expandido): faixa que ocupa a cápsula inteira. -->
                    <ContentPresenter x:Name="ExpandedLayer" Grid.RowSpan="3"
                                      Style="{StaticResource LayerStyle}"
                                      Content="{Binding ExpandedContent}"
                                      ContentTemplateSelector="{StaticResource ExpandedTemplates}"
                                      RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform />
                                <TranslateTransform />
                            </TransformGroup>
                        </ContentPresenter.RenderTransform>
                    </ContentPresenter>

                    <!-- Ilha aberta: o painel do módulo entre a data/hora e as bolinhas. -->
                    <ContentPresenter x:Name="InteractiveLayer" Grid.Row="1" Margin="26,0"
                                      Style="{StaticResource LayerStyle}"
                                      Content="{Binding InteractiveContent}"
                                      ContentTemplateSelector="{StaticResource InteractiveTemplates}"
                                      RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform />
                                <TranslateTransform />
                            </TransformGroup>
                        </ContentPresenter.RenderTransform>
                    </ContentPresenter>

                    <!-- Data e hora no alto da ilha aberta: "qui., 12 nov" em cinza e a hora em negrito. -->
                    <StackPanel x:Name="StatusBar" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False" Opacity="0">
                        <TextBlock Text="{Binding StatusDate}" FontFamily="{DynamicResource IslandTextFont}" FontSize="11.5"
                                   Foreground="{StaticResource IslandSecondaryTextBrush}" />
                        <TextBlock Text="{Binding StatusTime}" Margin="4,0,0,0" FontFamily="{DynamicResource IslandTextFont}" FontSize="11.5" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                    </StackPanel>

                    <!-- Setas ‹ › nas laterais do painel (só com mais de uma página). -->
                    <Grid x:Name="Pager" Grid.RowSpan="3" Opacity="0" IsHitTestVisible="False"
                          Visibility="{Binding HasPages, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource PageArrow}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,42,0,0"
                                Command="{Binding PreviousPageCommand}" ToolTip="Página anterior" AutomationProperties.Name="Página anterior">
                            <Path Data="M10,3.5 L5.5,8 L10,12.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" />
                        </Button>
                        <Button Style="{StaticResource PageArrow}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,42,12,0"
                                Command="{Binding NextPageCommand}" ToolTip="Próxima página" AutomationProperties.Name="Próxima página">
                            <Path Data="M6,3.5 L10.5,8 L6,12.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <!-- Bolinhas das páginas: a da página aberta fica comprida e branca; clicar numa abre aquela página. -->
                    <ItemsControl x:Name="Dots" Grid.Row="2" ItemsSource="{Binding Dock}" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Top"
                                  Margin="0,3,0,0" Opacity="0" IsHitTestVisible="False"
                                  Visibility="{Binding HasPages, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PageDot}" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding DataContext.OpenDockItemCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        Indicadores de privacidade (só no compacto): microfone (laranja) e câmera (verde) em uso,
                        empilhados na folga direita da cápsula (o conteúdo compacto termina 14 px antes da borda).
                        Visibilidade e fade são controlados pela janela (ApplyPrivacyDot).
                    -->
                    <StackPanel Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Ellipse x:Name="MicrophoneDot" Width="8" Height="8" Margin="0,1"
                                 Fill="{StaticResource IslandMicBrush}" Stroke="{StaticResource IslandPrivacyDotRingBrush}" StrokeThickness="1"
                                 Visibility="Collapsed" Opacity="0"
                                 IsHitTestVisible="{Binding ShowMicrophoneDot}"
                                 AutomationProperties.Name="Microfone em uso"
                                 ToolTip="{Binding MicrophoneToolTip}" />
                        <Ellipse x:Name="CameraDot" Width="8" Height="8" Margin="0,1"
                                 Fill="{StaticResource IslandCameraBrush}" Stroke="{StaticResource IslandPrivacyDotRingBrush}" StrokeThickness="1"
                                 Visibility="Collapsed" Opacity="0"
                                 IsHitTestVisible="{Binding ShowCameraDot}"
                                 AutomationProperties.Name="Câmera em uso"
                                 ToolTip="{Binding CameraToolTip}" />
                    </StackPanel>

                    <!-- Eventos agrupados (ex.: várias mensagens do mesmo app): "+N" no canto. -->
                    <Border Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,12,0" Padding="6,1"
                            CornerRadius="8" Background="{DynamicResource IslandSurfaceBrush}" IsHitTestVisible="False"
                            Visibility="{Binding HasGroupBadge, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding GroupBadge}" FontSize="10" FontFamily="{DynamicResource IslandTextFont}"
                                   Foreground="{StaticResource IslandSecondaryTextBrush}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Orelhas (só encaixada em cima): duas curvas de 10px que ligam a pílula à borda da tela, como no Volum. -->
            <Path x:Name="EarLeft" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-9.5,0,0,0"
                  Data="M10,0 L0,0 A10,10 0 0 1 10,10 Z" Fill="{DynamicResource IslandBackgroundBrush}" IsHitTestVisible="False" Visibility="Collapsed" />
            <Path x:Name="EarRight" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-9.5,0"
                  Data="M0,0 L10,0 A10,10 0 0 0 0,10 Z" Fill="{DynamicResource IslandBackgroundBrush}" IsHitTestVisible="False" Visibility="Collapsed" />

            <!-- Anel de alerta: pulsa uma vez ao chegar um aviso importante (IslandAlertPulse). -->
            <Border x:Name="AlertRing"
                    BorderBrush="{DynamicResource IslandAccentBrush}"
                    BorderThickness="2"
                    Opacity="0"
                    IsHitTestVisible="False"
                    RenderTransformOrigin="0.5,0.5">
                <Border.CornerRadius>
                    <MultiBinding Converter="{StaticResource IslandCornerRadius}">
                        <Binding Path="CornerSize" ElementName="Root" />
                        <Binding Path="Shape" ElementName="Root" />
                    </MultiBinding>
                </Border.CornerRadius>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="AlertRingScale" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </Grid>
</Window>
