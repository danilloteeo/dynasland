<Window x:Class="Dynasland.App.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Dynasland.App.ViewModels"
        xmlns:views="clr-namespace:Dynasland.App.Views"
        xmlns:common="clr-namespace:Dynasland.Modules.Common;assembly=Dynasland.Modules"
        xmlns:models="clr-namespace:Dynasland.Core.Models;assembly=Dynasland.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:IslandViewModel}"
        x:Name="Root"
        Title="Dynasland"
        Width="480"
        Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        UseLayoutRounding="True">

    <!--
        A janela tem tamanho fixo (IslandLayout.Maximum + rodapé + folga para overshoot e sombra) e é
        totalmente transparente: pixels com alfa 0 deixam os cliques passarem para o que está atrás.
        Apenas a cápsula (IslandHost) é animada, evitando redimensionar o HWND a cada frame.
    -->
    <Window.Resources>
        <common:GlyphContentConverter x:Key="GlyphContent" />
        <views:ActivityTemplateSelector x:Key="CompactTemplates" Mode="{x:Static models:IslandState.Compact}" />
        <views:ActivityTemplateSelector x:Key="ExpandedTemplates" Mode="{x:Static models:IslandState.Expanded}" />
        <views:ActivityTemplateSelector x:Key="InteractiveTemplates" Mode="{x:Static models:IslandState.Interactive}" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="LayerStyle" TargetType="ContentPresenter">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource IslandIconButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource IslandSecondaryTextBrush}" />
        </Style>

        <!-- Ícone da dock: botão redondo; o do módulo em foco vira pílula branca (como a atividade ativa do Volum). -->
        <Style x:Key="DockItemButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontFamily" Value="{StaticResource IslandIconFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource IslandSecondaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="Transparent" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource IslandSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource IslandPrimaryTextBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource IslandFillBrush}" />
                                <Setter Property="Foreground" Value="#FF090909" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Palco: entrada e saída da ilha inteira (opacidade, escala e subida), como a abertura do cartão do Volum. -->
    <Grid x:Name="Stage" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="StageScale" />
                <TranslateTransform x:Name="StageShift" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid x:Name="IslandHost"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              RenderTransformOrigin="0.5,0"
              Cursor="Hand"
              MouseEnter="OnIslandMouseEnter"
              MouseLeave="OnIslandMouseLeave"
              MouseLeftButtonUp="OnIslandMouseLeftButtonUp">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="HoverScaleTransform" />
            </Grid.RenderTransform>

            <!-- Camada separada para a sombra: o efeito não afeta a renderização do texto. -->
            <Border x:Name="ShadowBorder" Background="{DynamicResource IslandBackgroundBrush}">
                <Border.CornerRadius>
                    <MultiBinding Converter="{StaticResource IslandCornerRadius}">
                        <Binding Path="CornerSize" ElementName="Root" />
                        <Binding Path="Shape" ElementName="Root" />
                    </MultiBinding>
                </Border.CornerRadius>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="4"
                                      Direction="270"
                                      Opacity="{DynamicResource IslandShadowOpacity}"
                                      Color="Black"
                                      RenderingBias="Performance" />
                </Border.Effect>
            </Border>

            <Border Background="{DynamicResource IslandBackgroundBrush}"
                    BorderBrush="{StaticResource IslandEdgeBrush}"
                    BorderThickness="1">
                <Border.CornerRadius>
                    <MultiBinding Converter="{StaticResource IslandCornerRadius}">
                        <Binding Path="CornerSize" ElementName="Root" />
                        <Binding Path="Shape" ElementName="Root" />
                    </MultiBinding>
                </Border.CornerRadius>
                <Grid x:Name="ContentGrid" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <!-- Conteúdo do módulo (expandido/interativo); altura 0 no compacto. -->
                        <RowDefinition x:Name="ContentRowDefinition" Height="*" />
                        <!-- A dock: sempre visível. -->
                        <RowDefinition x:Name="FooterRow" Height="48" />
                    </Grid.RowDefinitions>

                    <ContentPresenter x:Name="ExpandedLayer"
                                      Style="{StaticResource LayerStyle}"
                                      Content="{Binding ExpandedContent}"
                                      ContentTemplateSelector="{StaticResource ExpandedTemplates}">
                        <ContentPresenter.RenderTransform>
                            <TranslateTransform />
                        </ContentPresenter.RenderTransform>
                    </ContentPresenter>
                    <ContentPresenter x:Name="InteractiveLayer"
                                      Style="{StaticResource LayerStyle}"
                                      Content="{Binding InteractiveContent}"
                                      ContentTemplateSelector="{StaticResource InteractiveTemplates}">
                        <ContentPresenter.RenderTransform>
                            <TranslateTransform />
                        </ContentPresenter.RenderTransform>
                    </ContentPresenter>

                    <!--
                        Indicadores de privacidade (só no compacto): microfone (laranja) e câmera (verde) em uso,
                        empilhados na folga direita da cápsula (o conteúdo compacto termina 14 px antes da borda).
                        Visibilidade e fade são controlados pela janela (ApplyPrivacyDot).
                    -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                        <Ellipse x:Name="MicrophoneDot" Width="8" Height="8" Margin="0,1"
                                 Fill="{StaticResource IslandMicBrush}" Stroke="{StaticResource IslandPrivacyDotRingBrush}" StrokeThickness="1"
                                 Visibility="Collapsed" Opacity="0"
                                 IsHitTestVisible="{Binding ShowMicrophoneDot}"
                                 AutomationProperties.Name="Microfone em uso"
                                 ToolTip="{Binding MicrophoneToolTip}" />
                        <Ellipse x:Name="CameraDot" Width="8" Height="8" Margin="0,1"
                                 Fill="{StaticResource IslandCameraBrush}" Stroke="{StaticResource IslandPrivacyDotRingBrush}" StrokeThickness="1"
                                 Visibility="Collapsed" Opacity="0"
                                 IsHitTestVisible="{Binding ShowCameraDot}"
                                 AutomationProperties.Name="Câmera em uso"
                                 ToolTip="{Binding CameraToolTip}" />
                    </StackPanel>

                    <!-- Eventos agrupados (ex.: várias mensagens do mesmo app): "+N" no canto. -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,12,0" Padding="6,1"
                            CornerRadius="8" Background="{DynamicResource IslandSurfaceBrush}" IsHitTestVisible="False"
                            Visibility="{Binding HasGroupBadge, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding GroupBadge}" FontSize="10" FontFamily="{DynamicResource IslandTextFont}"
                                   Foreground="{StaticResource IslandSecondaryTextBrush}" />
                    </Border>

                    <!-- Dock: um ícone por módulo, o texto compacto da atividade ao lado e, no interativo, as ferramentas. -->
                    <DockPanel x:Name="DockBar" Grid.Row="1" Margin="10,0">
                        <StackPanel x:Name="Footer" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    Opacity="0" IsHitTestVisible="False">
                            <Button Style="{StaticResource FooterButton}" Content="{Binding PinGlyph, Converter={StaticResource GlyphContent}}" Command="{Binding TogglePinCommand}"
                                    ToolTip="{Binding PinToolTip}"
                                    Visibility="{Binding CanPinFocused, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource FooterButton}" Content="{Binding Source={x:Static common:VectorIcons.Close}, Converter={StaticResource GlyphContent}}" Command="{Binding DismissCommand}"
                                    ToolTip="Fechar esta atividade"
                                    Visibility="{Binding CanDismissFocused, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource FooterButton}" Content="{Binding Source={x:Static common:VectorIcons.Gear}, Converter={StaticResource GlyphContent}}" Command="{Binding OpenSettingsCommand}"
                                    ToolTip="Configurações" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Dock}" Focusable="False" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DockItemButton}"
                                            Content="{Binding Glyph, Converter={StaticResource GlyphContent}}"
                                            ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                                            Command="{Binding DataContext.OpenDockItemCommand, ElementName=Root}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ContentPresenter x:Name="CompactLayer"
                                          Style="{StaticResource LayerStyle}"
                                          Content="{Binding CompactContent}"
                                          ContentTemplateSelector="{StaticResource CompactTemplates}">
                            <ContentPresenter.RenderTransform>
                                <TranslateTransform />
                            </ContentPresenter.RenderTransform>
                        </ContentPresenter>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Anel de alerta: pulsa uma vez ao chegar um aviso importante (IslandAlertPulse). -->
            <Border x:Name="AlertRing"
                    BorderBrush="{DynamicResource IslandAccentBrush}"
                    BorderThickness="2"
                    Opacity="0"
                    IsHitTestVisible="False"
                    RenderTransformOrigin="0.5,0.5">
                <Border.CornerRadius>
                    <MultiBinding Converter="{StaticResource IslandCornerRadius}">
                        <Binding Path="CornerSize" ElementName="Root" />
                        <Binding Path="Shape" ElementName="Root" />
                    </MultiBinding>
                </Border.CornerRadius>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="AlertRingScale" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </Grid>
</Window>
