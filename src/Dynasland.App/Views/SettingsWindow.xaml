<Window x:Class="Dynasland.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Dynasland.App.ViewModels"
        xmlns:converters="clr-namespace:Dynasland.App.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Configurações do Dynasland"
        Width="920" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SettingsBackgroundBrush}"
        Foreground="{DynamicResource SettingsTextBrush}"
        FontFamily="{StaticResource IslandTextFont}"
        UseLayoutRounding="True">

    <Window.Resources>
        <converters:EnumMatchConverter x:Key="EnumMatch" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navegação: cada categoria tem sua própria página (Views/Settings). -->
        <Border Background="{DynamicResource SettingsSidebarBrush}">
            <DockPanel Margin="14,18,14,10">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="52" Margin="8,0,0,6">
                    <Border Width="30" Height="14" CornerRadius="7" Background="Black" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1" VerticalAlignment="Center" />
                    <TextBlock Text="Dynasland" FontSize="14" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBar}" />
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <RadioButton Style="{StaticResource NavButton}" Tag="vector:home" Content="Geral"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=General}" />
                        <RadioButton Style="{StaticResource NavButton}" Tag="vector:palette" Content="Aparência"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Appearance}" />
                        <RadioButton Style="{StaticResource NavButton}" Tag="vector:sparkles" Content="Animações"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Animations}" />
                        <RadioButton Style="{StaticResource NavButton}" Tag="vector:sliders" Content="Comportamento"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Behavior}" />
                        <RadioButton Style="{StaticResource NavButton}" Tag="vector:monitor" Content="Monitores"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Monitors}" />
                        <RadioButton Style="{StaticResource NavButton}" Tag="vector:modules" Content="Módulos"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Modules}" />
                        <RadioButton Style="{StaticResource NavButton}" Tag="vector:bell" Content="Notificações"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Notifications}" />
                        <RadioButton Style="{StaticResource NavButton}" Tag="vector:lock" Content="Privacidade"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Privacy}" />
                        <RadioButton Style="{StaticResource NavButton}" Tag="vector:keyboard" Content="Atalhos"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Shortcuts}" />
                        <RadioButton Style="{StaticResource NavButton}" Tag="vector:storage" Content="Armazenamento"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=Storage}" />
                        <RadioButton Style="{StaticResource NavButton}" Tag="vector:info" Content="Sobre"
                                     IsChecked="{Binding Section, Converter={StaticResource EnumMatch}, ConverterParameter=About}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="36,26,30,30">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBar}" />
            </ScrollViewer.Resources>
            <ContentControl x:Name="PageHost" MaxWidth="760" HorizontalAlignment="Left" Focusable="False" />
        </ScrollViewer>
    </Grid>
</Window>
