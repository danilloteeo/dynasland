<UserControl x:Class="Dynasland.App.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dynasland.App.Controls"
             x:Name="Root" Focusable="False">
    <!-- Estado vazio: o mascote e uma frase curta, centralizados. -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24">
        <controls:PixelMascot Width="56" Height="28" HorizontalAlignment="Center"
                              TextElement.Foreground="{DynamicResource SettingsTertiaryTextBrush}" />
        <TextBlock Text="{Binding Text, ElementName=Root}" Margin="0,14,0,0" MaxWidth="320" TextAlignment="Center" TextWrapping="Wrap"
                   Style="{StaticResource CardDescription}" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
