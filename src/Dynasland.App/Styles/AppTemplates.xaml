<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Conteúdos da própria aplicação exibidos na ilha (mesma convenção de chave dos módulos). -->
    <DataTemplate x:Key="Dynasland.App.ViewModels.UpdateAvailableContent:Expanded">
        <Grid Margin="20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IslandIconFont}" FontSize="18"
                           Foreground="{DynamicResource IslandAccentBrush}" VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="Atualização disponível" FontFamily="{DynamicResource IslandTextFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                    <TextBlock Text="{Binding Version, StringFormat=Dynasland {0}}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.App.ViewModels.UpdateAvailableContent:Interactive">
        <Grid Margin="22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IslandIconFont}" FontSize="18"
                           Foreground="{DynamicResource IslandAccentBrush}" VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0">
                    <TextBlock Text="Atualização disponível" FontFamily="{DynamicResource IslandTextFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandPrimaryTextBrush}" />
                    <TextBlock Text="{Binding Version, StringFormat=Dynasland {0}}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource IslandTextButtonStyle}" Content="Agora não" Command="{Binding DismissCommand}" />
                <Button Style="{DynamicResource IslandTextButtonStyle}" Content="Baixar" Command="{Binding DownloadCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
