<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="clr-namespace:Dynasland.Modules.Common;assembly=Dynasland.Modules">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

    <!--
        Ícone vetorial próprio (chaves "vector:..." trocadas pelo GlyphContentConverter). Desenha como um glifo de fonte:
        tamanho = FontSize herdado e traço na cor do texto herdada, então segue tema, hover e o tamanho de cada lugar.
    -->
    <DataTemplate DataType="{x:Type common:VectorIcon}">
        <Viewbox Width="{Binding (TextElement.FontSize), RelativeSource={RelativeSource Self}}"
                 Height="{Binding (TextElement.FontSize), RelativeSource={RelativeSource Self}}">
            <Canvas Width="24" Height="24">
                <Path Data="{Binding Outline}" Fill="{x:Null}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                <Path Data="{Binding Detail}" Fill="{x:Null}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- Conteúdos da própria aplicação exibidos na ilha (mesma convenção de chave dos módulos). -->
    <!-- Título e detalhe da atualização (aviso, download, instalação ou falha), com a barra de download. -->
    <DataTemplate x:Key="UpdateSummary">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Glyph" Text="{Binding Glyph}" FontFamily="{DynamicResource IslandIconFont}" FontSize="18"
                       Foreground="{DynamicResource IslandAccentBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Flow.Title}" FontFamily="{DynamicResource IslandTextFont}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Flow.Detail}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                <Border Height="3" CornerRadius="1.5" Margin="0,6,0,0" Background="{DynamicResource IslandSurfaceBrush}"
                        Visibility="{Binding Flow.IsDownloading, Converter={StaticResource BooleanToVisibility}}">
                    <Border CornerRadius="1.5" Background="{DynamicResource IslandAccentBrush}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding Flow.Progress}" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Flow.HasFailed}" Value="True">
                <Setter TargetName="Glyph" Property="Text" Value="&#xEA39;" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource IslandCriticalBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Conteúdos da própria aplicação exibidos na ilha (mesma convenção de chave dos módulos). -->
    <DataTemplate x:Key="Dynasland.App.ViewModels.UpdateAvailableContent:Compact">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource IslandIconFont}" FontSize="13"
                       Foreground="{DynamicResource IslandAccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Flow.Percent, StringFormat={}{0}%}" Margin="8,0,0,0" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                       Foreground="{DynamicResource IslandPrimaryTextBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.App.ViewModels.UpdateAvailableContent:Expanded">
        <ContentPresenter Margin="20,0" Content="{Binding}" ContentTemplate="{StaticResource UpdateSummary}" VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.App.ViewModels.UpdateAvailableContent:Interactive">
        <Grid Margin="22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource UpdateSummary}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        Visibility="{Binding Flow.IsAvailable, Converter={StaticResource BooleanToVisibility}}">
                <Button Style="{DynamicResource IslandTextButtonStyle}" Content="Agora não" Command="{Binding DismissCommand}" />
                <Button Style="{DynamicResource IslandTextButtonStyle}" Content="{Binding Flow.ActionLabel}" Command="{Binding Flow.InstallCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Estado padrão (carregando / vazio / erro / aviso), compartilhado por todos os módulos. -->
    <DataTemplate x:Key="StatusGlyph">
        <TextBlock x:Name="Glyph" Text="&#xE946;" FontFamily="{DynamicResource IslandIconFont}" FontSize="18"
                   Foreground="{DynamicResource IslandSecondaryTextBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <RotateTransform />
            </TextBlock.RenderTransform>
        </TextBlock>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Loading">
                <Setter TargetName="Glyph" Property="Text" Value="&#xE895;" />
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="Spin">
                        <Storyboard Timeline.DesiredFrameRate="30">
                            <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Spin" />
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Empty">
                <Setter TargetName="Glyph" Property="Text" Value="&#xE8F4;" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource IslandTertiaryTextBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Error">
                <Setter TargetName="Glyph" Property="Text" Value="&#xEA39;" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource IslandCriticalBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Info">
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource IslandAccentBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Core.Activities.StatusContent:Compact">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusGlyph}" TextElement.FontSize="13" />
            <TextBlock Text="{Binding Title}" Margin="8,0,0,0" FontFamily="{DynamicResource IslandTextFont}" FontSize="12"
                       Foreground="{DynamicResource IslandPrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Core.Activities.StatusContent:Expanded">
        <Grid Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusGlyph}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource IslandTextFont}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource IslandPrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Message}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}"
                           Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Dynasland.Core.Activities.StatusContent:Interactive">
        <Grid Margin="22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusGlyph}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Margin="12,0,0,0" MaxWidth="320">
                    <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource IslandTextFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource IslandPrimaryTextBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource IslandSecondaryTextBrush}"
                               Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibility}}" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Row="1" HorizontalAlignment="Right" Style="{DynamicResource IslandTextButtonStyle}"
                    Content="{Binding ActionLabel}" Command="{Binding Action}"
                    Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibility}}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
