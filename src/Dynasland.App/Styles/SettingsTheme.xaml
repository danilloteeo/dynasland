<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Tema da janela de configurações. Os valores abaixo são o tema escuro padrão; o ThemeService
        substitui os pincéis em tempo de execução (claro/escuro/destaque), por isso tudo usa DynamicResource.
    -->
    <SolidColorBrush x:Key="SettingsBackgroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="SettingsSidebarBrush" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="SettingsCardBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="SettingsCardHoverBrush" Color="#FF323232" />
    <SolidColorBrush x:Key="SettingsBorderBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="SettingsTextBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="SettingsSecondaryTextBrush" Color="#FFB8B8B8" />
    <SolidColorBrush x:Key="SettingsTertiaryTextBrush" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="SettingsNavHoverBrush" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="SettingsButtonBrush" Color="#FF373737" />
    <SolidColorBrush x:Key="SettingsButtonHoverBrush" Color="#FF404040" />
    <SolidColorBrush x:Key="SettingsButtonBorderBrush" Color="#FF444444" />
    <SolidColorBrush x:Key="SettingsChipBrush" Color="#FF333333" />
    <SolidColorBrush x:Key="SettingsTrackBrush" Color="#FF555555" />
    <SolidColorBrush x:Key="SettingsScrollThumbBrush" Color="#FF5A5A5A" />
    <SolidColorBrush x:Key="SettingsAccentBrush" Color="#FF30D158" />
    <SolidColorBrush x:Key="SettingsAccentTextBrush" Color="#FF1B1B1B" />

    <SolidColorBrush x:Key="StatusActiveBrush" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="StatusDisabledBrush" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="StatusUnavailableBrush" Color="#FFE8A33A" />
    <SolidColorBrush x:Key="StatusFailedBrush" Color="#FFFF6B6B" />

    <Style x:Key="SettingsTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
    </Style>

    <Style x:Key="SettingsSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsGroupHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
        <Setter Property="Margin" Value="2,22,0,8" />
    </Style>

    <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SettingsCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
    </Style>

    <Style x:Key="CardDescription" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- Item de navegação lateral. O ícone vem do Tag. -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="12,9">
                        <Grid>
                            <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                    Margin="-8,0,0,0" Background="{DynamicResource SettingsAccentBrush}" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IslandIconFont}" FontSize="15"
                                           VerticalAlignment="Center" Margin="2,0,12,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsNavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsNavHoverBrush}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruptor liga/desliga (CheckBox). -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsSecondaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock x:Name="Label" Text="Desligado" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                                   Width="70" TextAlignment="Right" Margin="0,0,10,0" />
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{DynamicResource SettingsSecondaryTextBrush}" Background="Transparent">
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="{DynamicResource SettingsSecondaryTextBrush}"
                                     HorizontalAlignment="Left" Margin="4,0" />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource SettingsAccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource SettingsAccentTextBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Label" Property="Text" Value="Ligado" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Opção exclusiva em forma de linha (monitor, tema, modo de notificações). -->
    <Style x:Key="OptionRow" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="{DynamicResource SettingsCardBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource SettingsSecondaryTextBrush}" StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource SettingsAccentBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsCardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Amostra de cor de destaque. -->
    <Style x:Key="AccentSwatch" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource SettingsTextBrush}" StrokeThickness="2" Visibility="Collapsed" />
                        <Ellipse Margin="5" Fill="{TemplateBinding Background}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{DynamicResource SettingsButtonBrush}" BorderBrush="{DynamicResource SettingsButtonBorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="14,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
        <Setter Property="Foreground" Value="{DynamicResource SettingsAccentTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{DynamicResource SettingsAccentBrush}" CornerRadius="5" Padding="14,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatusChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="{DynamicResource SettingsChipBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Slider das configurações: preenchimento na cor de destaque (legível nos dois temas). -->
    <Style x:Key="SettingsSliderRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsSlider" TargetType="Slider">
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource SettingsSliderRepeat}" Background="{DynamicResource SettingsAccentBrush}" Command="Slider.DecreaseLarge" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource SettingsSliderRepeat}" Background="{DynamicResource SettingsTrackBrush}" Command="Slider.IncreaseLarge" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Width="18" Height="18">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid>
                                            <Ellipse Fill="{DynamicResource SettingsCardBrush}" Stroke="{DynamicResource SettingsBorderBrush}" StrokeThickness="1" />
                                            <Ellipse Margin="5" Fill="{DynamicResource SettingsAccentBrush}" />
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Barra de rolagem fina, no tom do tema. -->
    <Style x:Key="SettingsScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Margin="3,2" Background="{DynamicResource SettingsScrollThumbBrush}" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
