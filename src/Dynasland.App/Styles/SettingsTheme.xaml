<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema da janela de configurações: superfícies escuras em tons de cinza (Fluent). -->
    <SolidColorBrush x:Key="SettingsBackgroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="SettingsSidebarBrush" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="SettingsCardBrush" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="SettingsCardHoverBrush" Color="#FF323232" />
    <SolidColorBrush x:Key="SettingsBorderBrush" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="SettingsTextBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="SettingsSecondaryTextBrush" Color="#FFB8B8B8" />
    <SolidColorBrush x:Key="SettingsTertiaryTextBrush" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="SettingsAccentBrush" Color="#FF4CC2FF" />
    <SolidColorBrush x:Key="SettingsAccentTextBrush" Color="#FF003A57" />

    <SolidColorBrush x:Key="StatusActiveBrush" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="StatusDisabledBrush" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="StatusUnavailableBrush" Color="#FFFCB040" />
    <SolidColorBrush x:Key="StatusFailedBrush" Color="#FFFF6B6B" />

    <Style x:Key="SettingsTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
    </Style>

    <Style x:Key="SettingsSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SettingsSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsGroupHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
        <Setter Property="Margin" Value="2,22,0,8" />
    </Style>

    <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SettingsCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SettingsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
    </Style>

    <Style x:Key="CardDescription" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SettingsSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- Item de navegação lateral. -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="12,9">
                        <Grid>
                            <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                    Margin="-8,0,0,0" Background="{StaticResource SettingsAccentBrush}" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource IslandIconFont}" FontSize="15"
                                           VerticalAlignment="Center" Margin="2,0,12,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FF2D2D2D" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FF2D2D2D" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruptor liga/desliga (CheckBox). -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource SettingsSecondaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock x:Name="Label" Text="Desligado" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                                   Width="70" TextAlignment="Right" Margin="0,0,10,0" />
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{StaticResource SettingsSecondaryTextBrush}" Background="Transparent">
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="{StaticResource SettingsSecondaryTextBrush}"
                                     HorizontalAlignment="Left" Margin="4,0" />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource SettingsAccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource SettingsAccentTextBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Label" Property="Text" Value="Ligado" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Opção exclusiva em forma de linha (escolha de monitor). -->
    <Style x:Key="OptionRow" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="{StaticResource SettingsCardBrush}" BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse Stroke="{StaticResource SettingsSecondaryTextBrush}" StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource SettingsAccentBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SettingsCardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="#FF373737" BorderBrush="#FF444444" BorderThickness="1" CornerRadius="5" Padding="14,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FF404040" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FF303030" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatusChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="#FF333333" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

</ResourceDictionary>
