<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Dynasland.App.Controls"
                    xmlns:common="clr-namespace:Dynasland.Modules.Common;assembly=Dynasland.Modules">

    <common:GlyphContentConverter x:Key="GlyphContent" />

    <!--
        Tema da janela de configurações. Os valores abaixo são o tema escuro padrão; o ThemeService
        substitui os pincéis em tempo de execução (claro/escuro/destaque), por isso tudo usa DynamicResource.
    -->
    <SolidColorBrush x:Key="SettingsBackgroundBrush" Color="#FF090909" />
    <SolidColorBrush x:Key="SettingsSidebarBrush" Color="#FF0D0D0D" />
    <SolidColorBrush x:Key="SettingsCardBrush" Color="#FF101010" />
    <SolidColorBrush x:Key="SettingsCardHoverBrush" Color="#FF161616" />
    <SolidColorBrush x:Key="SettingsBorderBrush" Color="#FF1C1C1C" />
    <SolidColorBrush x:Key="SettingsTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SettingsSecondaryTextBrush" Color="#FFB8B8B8" />
    <SolidColorBrush x:Key="SettingsTertiaryTextBrush" Color="#FF757575" />
    <SolidColorBrush x:Key="SettingsNavHoverBrush" Color="#FF161616" />
    <SolidColorBrush x:Key="SettingsButtonBrush" Color="#FF161616" />
    <SolidColorBrush x:Key="SettingsButtonHoverBrush" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="SettingsButtonBorderBrush" Color="#FF262626" />
    <SolidColorBrush x:Key="SettingsChipBrush" Color="#FF161616" />
    <SolidColorBrush x:Key="SettingsTrackBrush" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="SettingsScrollThumbBrush" Color="#FF333333" />
    <SolidColorBrush x:Key="SettingsAccentBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SettingsAccentTextBrush" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="WaterBlueBrush" Color="#FF0084FF" />

    <SolidColorBrush x:Key="StatusActiveBrush" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="StatusDisabledBrush" Color="#FF8A8A8A" />
    <SolidColorBrush x:Key="StatusUnavailableBrush" Color="#FFE8A33A" />
    <SolidColorBrush x:Key="StatusFailedBrush" Color="#FFFF6B6B" />

    <Style x:Key="SettingsTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
    </Style>

    <Style x:Key="SettingsSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsGroupHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
        <Setter Property="Margin" Value="2,22,0,8" />
    </Style>

    <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SettingsCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
    </Style>

    <Style x:Key="CardDescription" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- Item de navegação lateral. O ícone vem do Tag. -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="12,9">
                        <Grid>
                            <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                    Margin="-8,0,0,0" Background="{DynamicResource SettingsAccentBrush}" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal">
                                <!-- Glifo de fonte no TextBlock; um Tag "vector:..." deixa o texto vazio e desenha o ícone vetorial
                                     (16 px, mas ocupando os 15 px de um glifo, para o texto alinhar com os outros itens). -->
                                <Grid VerticalAlignment="Center" Margin="2,0,12,0">
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource GlyphContent}, ConverterParameter=glyph}"
                                               FontFamily="{StaticResource IslandIconFont}" FontSize="15" VerticalAlignment="Center" />
                                    <ContentPresenter Content="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource GlyphContent}, ConverterParameter=vector}"
                                                      TextElement.FontSize="16" Margin="-0.5,0" VerticalAlignment="Center" />
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsNavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsNavHoverBrush}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interruptor liga/desliga (CheckBox). -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsSecondaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock x:Name="Label" Text="Desligado" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                                   Width="70" TextAlignment="Right" Margin="0,0,10,0" />
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{DynamicResource SettingsSecondaryTextBrush}" Background="Transparent">
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="{DynamicResource SettingsSecondaryTextBrush}"
                                     HorizontalAlignment="Left" Margin="4,0" />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource SettingsAccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource SettingsAccentTextBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Label" Property="Text" Value="Ligado" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Opção exclusiva em forma de linha (monitor, tema, modo de notificações). -->
    <Style x:Key="OptionRow" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="{DynamicResource SettingsCardBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource SettingsSecondaryTextBrush}" StrokeThickness="1.5" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource SettingsAccentBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsCardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Amostra de cor de destaque. -->
    <Style x:Key="AccentSwatch" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource SettingsTextBrush}" StrokeThickness="2" Visibility="Collapsed" />
                        <Ellipse Margin="5" Fill="{TemplateBinding Background}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Amostra de tema da ilha: uma cápsula com o fundo do tema e o nome embaixo. -->
    <Style x:Key="IslandThemeSwatch" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Background="Transparent" Width="92">
                        <Border x:Name="Ring" CornerRadius="17" BorderThickness="2" BorderBrush="Transparent" Padding="3">
                            <Border Height="24" CornerRadius="12" Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1" />
                        </Border>
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource IslandTextFont}" FontSize="11.5" Margin="0,4,0,0"
                                   Foreground="{DynamicResource SettingsSecondaryTextBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmentado: trilho + pílula que desliza (SegmentedControl) com RadioButtons SegmentItem.
         Pílula e conteúdo partem da borda externa; o recuo de 4 (1 de borda + 3 de folga) é o Inset do controle. -->
    <Style TargetType="{x:Type controls:SegmentedControl}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SegmentedControl}">
                    <Grid>
                        <Border Background="{DynamicResource SettingsChipBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}"
                                BorderThickness="1" CornerRadius="10" />
                        <Border x:Name="PART_Pill" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,4,0,4"
                                Background="{DynamicResource SettingsAccentBrush}" CornerRadius="7" Visibility="Collapsed" />
                        <ContentPresenter Margin="4" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentItem" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsSecondaryTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="Transparent">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SettingsAccentTextBrush}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IslandTextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{DynamicResource SettingsButtonBrush}" BorderBrush="{DynamicResource SettingsButtonBorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="14,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
        <Setter Property="Foreground" Value="{DynamicResource SettingsAccentTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{DynamicResource SettingsAccentBrush}" CornerRadius="5" Padding="14,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StatusChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="{DynamicResource SettingsChipBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- Slider das configurações: preenchimento na cor de destaque (legível nos dois temas). -->
    <Style x:Key="SettingsSliderRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsSlider" TargetType="Slider">
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource SettingsSliderRepeat}" Background="{DynamicResource SettingsAccentBrush}" Command="Slider.DecreaseLarge" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource SettingsSliderRepeat}" Background="{DynamicResource SettingsTrackBrush}" Command="Slider.IncreaseLarge" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Width="18" Height="18">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid>
                                            <Ellipse Fill="{DynamicResource SettingsCardBrush}" Stroke="{DynamicResource SettingsBorderBrush}" StrokeThickness="1" />
                                            <Ellipse Margin="5" Fill="{DynamicResource SettingsAccentBrush}" />
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Barra de rolagem fina, no tom do tema. -->
    <Style x:Key="SettingsScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Margin="3,2" Background="{DynamicResource SettingsScrollThumbBrush}" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Campo de texto (busca, formulários da Central e das configurações). -->
    <Style x:Key="SettingsTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SettingsCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsButtonBorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource SettingsTextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SettingsAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                       Foreground="{DynamicResource SettingsTertiaryTextBrush}" IsHitTestVisible="False"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lista da Central: itens como linhas selecionáveis, sem o realce azul padrão. -->
    <Style x:Key="HubListItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="{DynamicResource SettingsCardBrush}" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SettingsCardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão de ícone pequeno nas linhas da Central. -->
    <Style x:Key="HubIconButton" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource IslandIconFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsSecondaryTextBrush}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Back" Background="Transparent" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource SettingsButtonHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ComboBox no tema das janelas (implícito: vale para todas as listas suspensas). -->
    <Style x:Key="SettingsComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" Background="{DynamicResource SettingsButtonBrush}" BorderBrush="{DynamicResource SettingsButtonBorderBrush}"
                            BorderThickness="1" CornerRadius="5">
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IslandIconFont}" FontSize="10" Margin="0,0,10,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SettingsSecondaryTextBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SettingsButtonHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SettingsNavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource SettingsComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="10,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Background="{DynamicResource SettingsCardBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="4" Margin="0,2,0,0" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer>
                                    <ScrollViewer.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBar}" />
                                    </ScrollViewer.Resources>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
