<UserControl x:Class="DynaIsland.App.Controls.MiniPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DynaIsland.App.Controls"
             Focusable="False" IsTabStop="False">
    <!-- Mini pílula do DynaIsland: vidro com os olhos, a hora e as barrinhas da música; Pulse() abre de leve e volta. -->
    <Border x:Name="Capsule" Width="104" Height="28" CornerRadius="14" HorizontalAlignment="Left"
            Background="{DynamicResource IslandBackgroundBrush}" BorderBrush="{StaticResource IslandGlassBorderBrush}" BorderThickness="1">
        <Grid Margin="10,0,12,0">
            <!-- O mesmo mascote da ilha (Task 9B) antes da hora. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <controls:IslandEyes Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="Time" VerticalAlignment="Center" FontFamily="{StaticResource IslandTextFont}"
                           FontSize="11.5" FontWeight="Bold" Typography.NumeralAlignment="Tabular" Foreground="{StaticResource IslandPrimaryTextBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="10">
                <Rectangle Width="2.5" Height="5" Margin="1,0" RadiusX="1.25" RadiusY="1.25" VerticalAlignment="Bottom" Fill="{DynamicResource IslandAccentBrush}" />
                <Rectangle Width="2.5" Height="10" Margin="1,0" RadiusX="1.25" RadiusY="1.25" VerticalAlignment="Bottom" Fill="{DynamicResource IslandAccentBrush}" />
                <Rectangle Width="2.5" Height="7" Margin="1,0" RadiusX="1.25" RadiusY="1.25" VerticalAlignment="Bottom" Fill="{DynamicResource IslandAccentBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
