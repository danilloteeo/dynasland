<UserControl x:Class="DynaIsland.App.Controls.IslandEyes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsTabStop="False" IsHitTestVisible="False">
    <!-- Olhos da ilha: abertos (piscam e olham para os lados) ou, com música, fechados em arco e balançando. -->
    <Grid Width="16" Height="10">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Look" />
        </Grid.RenderTransform>
        <StackPanel x:Name="OpenEyes" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <ScaleTransform x:Name="Lids" />
            </StackPanel.RenderTransform>
            <Border Width="6" Height="8" CornerRadius="3" Background="{DynamicResource IslandPrimaryTextBrush}" />
            <Border Width="6" Height="8" CornerRadius="3" Margin="4,0,0,0" Background="{DynamicResource IslandPrimaryTextBrush}" />
        </StackPanel>
        <Canvas x:Name="ClosedEyes" Visibility="Collapsed">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="Nod" />
            </Canvas.RenderTransform>
            <Path Data="M0.8,6.5 A2.6,2.6 0 0 1 6,6.5" Stroke="{DynamicResource IslandPrimaryTextBrush}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Path Data="M10,6.5 A2.6,2.6 0 0 1 15.2,6.5" Stroke="{DynamicResource IslandPrimaryTextBrush}" StrokeThickness="1.6"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Canvas>
    </Grid>
</UserControl>
