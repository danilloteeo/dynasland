<ResourceDictionary
                    xmlns:common="clr-namespace:DynaIsland.Modules.Common" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <common:GlyphContentConverter x:Key="GlyphContent" />

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <DataTemplate x:Key="BluetoothDeviceRow">
        <Grid Height="34">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <ContentControl Content="{Binding Glyph, Converter={StaticResource GlyphContent}}" FontFamily="{DynamicResource IslandIconFont}" FontSize="16"
                            Foreground="{DynamicResource IslandSecondaryTextBrush}" VerticalAlignment="Center" Width="22" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{DynamicResource IslandTextFont}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource IslandPrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,10,0" />
            <ProgressBar Grid.Column="2" Style="{DynamicResource IslandProgressBarStyle}" Maximum="100" Value="{Binding Value, Mode=OneWay}"
                         VerticalAlignment="Center" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock x:Name="Percent" Grid.Column="3" Text="{Binding BatteryText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="12.5"
                       Foreground="{DynamicResource IslandSecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsLow}" Value="True">
                <Setter TargetName="Percent" Property="Foreground" Value="{DynamicResource IslandCriticalBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="DynaIsland.Modules.Bluetooth.BluetoothDevicesContent:Interactive">
        <Grid Margin="24,16">
            <TextBlock Text="{Binding EmptyText}" FontFamily="{DynamicResource IslandTextFont}" FontSize="13"
                       Foreground="{DynamicResource IslandTertiaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource BluetoothDeviceRow}" Focusable="False" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
