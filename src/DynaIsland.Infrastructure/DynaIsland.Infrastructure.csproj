<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(DynaIslandWindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>$(DynaIslandMinWindows)</SupportedOSPlatformVersion>
    <RootNamespace>DynaIsland.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynaIsland.Core\DynaIsland.Core.csproj" />
  </ItemGroup>

  <!--
    Motor nativo (C++): gerado por tools\Build-NativeEngine.ps1. Se ainda nao foi compilado, o aplicativo
    funciona sem ele (NativeEngineService fica indisponivel e os ganchos em C# assumem).
  -->
  <PropertyGroup>
    <NativeEngineDll>$(MSBuildThisFileDirectory)..\NativeEngine\build\bin\Release\DynaIslandEngine.dll</NativeEngineDll>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(NativeEngineDll)')">
    <None Include="$(NativeEngineDll)" Link="DynaIslandEngine.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DynaIsland.Tests" />
    <AssemblyMetadata Include="UpdateRepository" Value="$(DynaIslandUpdateRepository)" />
  </ItemGroup>

</Project>
